<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.TaxiAppDriver" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/driver_black_bg</item>
        <item name="colorPrimaryVariant">@color/driver_card_bg</item>
        <item name="colorOnPrimary">@color/driver_neon_teal</item>
        <item name="android:statusBarColor">@color/driver_black_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/driver_black_bg</item>

        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>

        <item name="colorSurface">@color/driver_card_bg</item>
        <item name="android:colorBackground">@color/driver_black_bg</item>
        <item name="android:windowBackground">@color/driver_black_bg</item>
        <item name="colorOnSurface">@color/driver_text_primary</item>

        <item name="android:fontFamily">@font/app_font_family</item>
        <item name="fontFamily">@font/app_font_family</item>
    </style>
    <style name="BottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/BottomSheetStyleBackend</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">false</item>

        <item name="android:navigationBarColor">@color/driver_black_bg</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <style name="BottomSheetStyleBackend" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>
    <style name="CarTabTextStyle" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="fontFamily">@font/app_font_family</item>
    </style>
    <style name="Shape.Card.Top" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">4dp</item>
        <item name="cornerSizeBottomRight">4dp</item>
    </style>
    <style name="EtherTabTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/app_font_family</item>
        <item name="android:textStyle">bold</item>
        <item name="textAllCaps">false</item>
    </style>
    <style name="RatingBarNoRipple" parent="Widget.AppCompat.RatingBar">
        <item name="colorControlNormal">@color/driver_text_secondary</item>
        <item name="colorControlActivated">@color/driver_neon_teal</item>
        <item name="android:colorControlHighlight">@android:color/transparent</item>
    </style>

    <style name="Shape.Card.FlatTop" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeBottomLeft">4dp</item>
        <item name="cornerSizeBottomRight">4dp</item>
    </style>

    <style name="Shape.Card.FlatBottom" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">4dp</item>
        <item name="cornerSizeTopRight">4dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="Shape.Card.Middle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">4dp</item>
    </style>

    <style name="Shape.Card.Bottom" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">4dp</item>
        <item name="cornerSizeTopRight">4dp</item>
        <item name="cornerSizeBottomLeft">24dp</item>
        <item name="cornerSizeBottomRight">24dp</item>
    </style>

    <style name="MenuTextStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:fontFamily">@font/app_font_family</item>
        <item name="fontFamily">@font/app_font_family</item>
    </style>

    <style name="MenuIconStyle">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="tint">@color/driver_text_secondary</item>
    </style>

    <style name="MenuStyle">
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingVertical">16dp</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="InfoButtonStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:padding">16dp</item>
        <item name="android:background">@drawable/bg_driver_input</item>
        <item name="android:backgroundTint">#1AFFFFFF</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="InfoButtonTextStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/driver_text_primary</item>
        <item name="android:fontFamily">@font/app_font_family</item>
        <item name="fontFamily">@font/app_font_family</item>
    </style>

    <style name="InfoButtonIconStyle">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:src">@drawable/ic_chevron</item>
        <item name="tint">@color/driver_text_secondary</item>
    </style>

    <style name="ListTextStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/driver_text_secondary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="drawableStartCompat">@drawable/ic_list_dot</item>
        <item name="drawableTint">@color/driver_text_secondary</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:fontFamily">@font/app_font_family</item>
        <item name="fontFamily">@font/app_font_family</item>
    </style>

    <style name="OtpDigitStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">4dp</item>
        <item name="android:background">@drawable/bg_otp_digit</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/driver_text_primary</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/app_font_family</item>
        <item name="fontFamily">@font/app_font_family</item>
    </style>
</resources>