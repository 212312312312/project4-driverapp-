<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Основний корпус 3D-картки з глибоким графітово-антрацитовим металевим переливом -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#1E2025"
                android:centerColor="#2D3038"
                android:endColor="#414550"
                android:type="linear" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <!-- М'який діагональний відблиск для об'єму (3D-ефект банківської картки) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:startColor="#00FFFFFF"
                android:centerColor="#12FFFFFF"
                android:endColor="#0533CCA1"
                android:type="linear" />
            <corners android:radius="20dp" />
            <stroke
                android:width="1dp"
                android:color="#2EFFFFFF" />
        </shape>
    </item>

</layer-list>