<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/wallet_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/driver_card_bg">

    <!-- ВЕРХНЯ ШАПКА З СЕГМЕНТНИМ ПЕРЕМИКАЧЕМ "БАЛАНС / ОПЕРАЦІЇ" (БЕЗ КНОПКИ INFO СПРАВА) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-16dp"
        app:cardBackgroundColor="@color/driver_black_bg"
        app:cardCornerRadius="22dp"
        app:cardElevation="6dp"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="12dp">

            <LinearLayout
                android:id="@+id/header_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="32dp"
                android:paddingBottom="12dp"
                android:paddingHorizontal="16dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    app:cardBackgroundColor="@color/driver_surface_elevated"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:id="@+id/btn_back"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="10dp"
                        android:src="@drawable/ic_arrow_back_black"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        app:tint="@color/driver_text_primary"
                        android:contentDescription="@null" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tv_wallet_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:text="Баланс"
                    android:textColor="@color/driver_text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/app_font_family" />
            </LinearLayout>

            <!-- Прихований TabLayout для сумісності + кастомний Segmented Pill як на референсі -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/wallet_tabs"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:visibility="gone">

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Баланс" />

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Операції" />
            </com.google.android.material.tabs.TabLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginHorizontal="12dp"
                app:cardBackgroundColor="@color/driver_surface_elevated"
                app:cardCornerRadius="13dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:padding="2dp"
                    android:weightSum="2">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/seg_tab_balance"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="#5A5E6D"
                        app:cardCornerRadius="11dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/driver_text_primary"
                        app:strokeWidth="1dp">

                        <TextView
                            android:id="@+id/tv_seg_balance"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="Баланс"
                            android:textColor="@color/driver_text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/app_font_family" />
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/seg_tab_operations"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@android:color/transparent"
                        app:cardCornerRadius="11dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@android:color/transparent"
                        app:strokeWidth="0dp">

                        <TextView
                            android:id="@+id/tv_seg_operations"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="Операції"
                            android:textColor="@color/driver_text_secondary"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/app_font_family" />
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- БЛОК БАЛАНСУ ТА ACTION-КНОПОК -->
    <LinearLayout
        android:id="@+id/balance_hero_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="24dp"
        android:paddingBottom="18dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Контейнер суми балансу АБО круглого білого спінера завантаження (як на відео 00:11-00:16) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp">

            <TextView
                android:id="@+id/tv_main_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                tools:text="262.27 ₴"
                android:textColor="@color/driver_text_primary"
                android:textSize="36sp"
                android:textStyle="bold"
                android:fontFamily="@font/app_font_family" />

            <ImageView
                android:id="@+id/iv_balance_loader"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="center"
                android:visibility="gone"
                android:contentDescription="@null" />
        </FrameLayout>

        <!-- Підзаголовок балансу (ЗАВЖДИ залишається видимим навіть при піднятій шторці, як на відео!) -->
        <TextView
            android:id="@+id/tv_balance_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="28dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="Баланс показує стан ваших розрахунків. Підтримуйте позитивний баланс, щоб приймати замовлення"
            android:textColor="@color/driver_text_secondary"
            android:textSize="14sp"
            android:fontFamily="@font/app_font_family" />

        <!-- Контейнер круглих кнопок дій (згортається при свайпі шторки вгору, як на відео 00:01-00:04) -->
        <FrameLayout
            android:id="@+id/balance_actions_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="22dp"
            android:paddingBottom="4dp">

            <!-- Кнопка "Поповнити баланс" (Вкладка Баланс) -->
            <LinearLayout
                android:id="@+id/btn_top_up"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    app:cardBackgroundColor="@color/driver_surface_elevated"
                    app:cardCornerRadius="30dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:id="@+id/iv_top_up_icon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="15dp"
                        android:src="@drawable/ic_wallet"
                        app:tint="@color/driver_text_primary"
                        android:contentDescription="@null" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:text="Поповнити\nбаланс"
                    android:textColor="@color/driver_text_secondary"
                    android:textSize="14sp"
                    android:fontFamily="@font/app_font_family" />
            </LinearLayout>

            <!-- Кнопки "Ваші картки" та "Ваші кошти" (Вкладка Операції) -->
            <LinearLayout
                android:id="@+id/layout_funds_buttons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:id="@+id/btn_my_cards"
                    android:layout_width="110dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="32dp"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless">

                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:layout_gravity="center"
                            app:cardBackgroundColor="@color/driver_surface_elevated"
                            app:cardCornerRadius="30dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <ImageView
                                android:id="@+id/iv_my_cards_icon"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="15dp"
                                android:src="@drawable/ic_wallet"
                                app:tint="@color/driver_text_primary"
                                android:contentDescription="@null" />
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="bottom|end"
                            android:layout_marginEnd="2dp"
                            android:layout_marginBottom="2dp"
                            app:cardBackgroundColor="@color/white"
                            app:cardCornerRadius="11dp"
                            app:cardElevation="2dp"
                            app:strokeColor="@color/driver_card_bg"
                            app:strokeWidth="1.5dp">

                            <ImageView
                                android:id="@+id/iv_my_cards_badge"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="4dp"
                                android:src="@drawable/ic_payment_card"
                                android:contentDescription="@null" />
                        </com.google.android.material.card.MaterialCardView>
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:lineSpacingExtra="2dp"
                        android:text="Ваші\nкартки"
                        android:textColor="@color/driver_text_secondary"
                        android:textSize="14sp"
                        android:fontFamily="@font/app_font_family" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_my_funds"
                    android:layout_width="110dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless">

                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:layout_gravity="center"
                            app:cardBackgroundColor="@color/driver_surface_elevated"
                            app:cardCornerRadius="30dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <ImageView
                                android:id="@+id/iv_my_funds_icon"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="15dp"
                                android:src="@drawable/ic_wallet"
                                app:tint="@color/driver_text_primary"
                                android:contentDescription="@null" />
                        </com.google.android.material.card.MaterialCardView>
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:lineSpacingExtra="2dp"
                        android:text="Ваші\nкошти"
                        android:textColor="@color/driver_text_secondary"
                        android:textSize="14sp"
                        android:fontFamily="@font/app_font_family" />
                </LinearLayout>

            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- НИЖНЯ ПАНЕЛЬ ІСТОРІЇ ТРАНЗАКЦІЙ (BOTTOM SHEET CARD З ПОВЗУНКОМ ТА ЗАКРІПЛЕНОЮ ДАТОЮ) -->
    <LinearLayout
        android:id="@+id/transactions_sheet_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="@drawable/bg_bottom_sheet_driver"
        app:layout_constraintTop_toBottomOf="@id/balance_hero_section"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Drag Handle Pill + Sticky Date Header (як на відео: "31 серп. 2026" завжди закріплений під повзунком) -->
        <LinearLayout
            android:id="@+id/sheet_drag_handle_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="10dp"
            android:paddingBottom="6dp"
            android:clickable="true"
            android:focusable="true">

            <View
                android:layout_width="38dp"
                android:layout_height="4dp"
                android:background="@drawable/bg_status_pill"
                android:backgroundTint="@color/driver_text_secondary"
                android:alpha="0.65" />

            <TextView
                android:id="@+id/tv_sticky_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="@color/driver_text_secondary"
                android:textSize="15sp"
                android:fontFamily="@font/app_font_family"
                android:visibility="gone"
                tools:text="31 серп. 2026"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_empty_transactions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:gravity="center"
            android:text="@string/wallet_history_empty"
            android:textColor="@color/driver_text_secondary"
            android:textSize="15sp"
            android:visibility="gone"
            android:fontFamily="@font/app_font_family" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_transactions"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingBottom="28dp"
            tools:listitem="@layout/item_wallet_transaction" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>