<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:layout_marginHorizontal="8dp"
    app:cardBackgroundColor="@color/driver_black_bg"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:cardMaxElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardCornerRadius="6dp"
                app:cardBackgroundColor="@color/driver_card_bg"
                app:strokeWidth="0dp"
                app:cardElevation="0dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true">

                <TextView
                    android:id="@+id/tv_status_archive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/history_item_status_archived"
                    android:textColor="@color/driver_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/app_font_family"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tv_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/driver_text_secondary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="@font/app_font_family"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                tools:text="24 лют. 10:35" />
        </RelativeLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <View
                android:id="@+id/view_route_line"
                android:layout_width="2dp"
                android:layout_height="0dp"
                android:background="@color/driver_text_secondary"
                android:alpha="0.25"
                app:layout_constraintTop_toTopOf="@id/iv_icon_from"
                app:layout_constraintBottom_toBottomOf="@id/iv_icon_to"
                app:layout_constraintStart_toStartOf="@id/iv_icon_from"
                app:layout_constraintEnd_toEndOf="@id/iv_icon_from" />

            <ImageView
                android:id="@+id/iv_icon_from"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_circle_green"
                android:layout_marginTop="4dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/ll_from_text" />

            <LinearLayout
                android:id="@+id/ll_from_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="14dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@id/iv_icon_from"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/tv_from"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/driver_text_primary"
                    android:textSize="15sp"
                    android:fontFamily="@font/app_font_family"
                    tools:text="Якуба Коласа Вулиця (Київ), 5" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_stops_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                app:layout_constraintTop_toBottomOf="@id/ll_from_text"
                app:layout_constraintBottom_toTopOf="@id/ll_to_text"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <ImageView
                android:id="@+id/iv_icon_to"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_circle_red"
                android:layout_marginTop="4dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/ll_to_text" />

            <LinearLayout
                android:id="@+id/ll_to_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="14dp"
                app:layout_constraintTop_toBottomOf="@id/ll_stops_container"
                app:layout_constraintStart_toEndOf="@id/iv_icon_to"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/tv_to"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/driver_text_primary"
                    android:textSize="15sp"
                    android:fontFamily="@font/app_font_family"
                    tools:text="Миколи Руденка Бульвар, 14м" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_driver_input"
                android:backgroundTint="@color/driver_card_bg"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:layout_marginEnd="6dp">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_menu_stats"
                    app:tint="#00E676" />

                <TextView
                    android:id="@+id/tv_activity_bonus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="+6"
                    android:textColor="#00E676"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/app_font_family" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_price_background"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_driver_input"
                android:backgroundTint="@color/driver_neon_teal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:layout_marginEnd="6dp">

                <ImageView
                    android:id="@+id/iv_payment_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/ic_payment_card"
                    app:tint="@color/black" />

                <TextView
                    android:id="@+id/tv_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/app_font_family"
                    android:textColor="@color/black"
                    tools:text="129 ₴" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_driver_input"
                android:backgroundTint="@color/driver_card_bg"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp">

                <TextView
                    android:id="@+id/tv_distance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/driver_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/app_font_family"
                    tools:text="2,30 км" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>