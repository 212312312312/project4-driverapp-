<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/container_active"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:visibility="gone"
        tools:visibility="visible">

        <androidx.cardview.widget.CardView
            android:id="@+id/card_active_order"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="@color/driver_black_bg"
            app:strokeWidth="0dp"
            app:cardElevation="4dp"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/orders_card_title"
                    android:textColor="@color/driver_neon_teal"
                    android:fontFamily="@font/app_font_family"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_marginBottom="12dp" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp">

                    <LinearLayout
                        android:id="@+id/ll_price_background"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_driver_input"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true">

                        <ImageView
                            android:id="@+id/iv_payment_icon"
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:layout_marginEnd="6dp"
                            tools:src="@drawable/ic_payment_cash" />

                        <TextView
                            android:id="@+id/tv_price"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/app_font_family"
                            tools:text="250₴"
                            tools:textColor="#000000" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="end"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true">

                        <TextView
                            android:id="@+id/tv_price_per_km"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/driver_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/app_font_family"
                            tools:text="24.33 ₴/км" />
                    </LinearLayout>
                </RelativeLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/guideline_address_block"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintGuide_begin="54dp" />

                    <View
                        android:id="@+id/view_route_line"
                        android:layout_width="2dp"
                        android:layout_height="0dp"
                        android:background="#444444"
                        app:layout_constraintTop_toTopOf="@id/iv_icon_from"
                        app:layout_constraintBottom_toBottomOf="@id/iv_icon_to"
                        app:layout_constraintStart_toStartOf="@id/iv_icon_from"
                        app:layout_constraintEnd_toEndOf="@id/iv_icon_from" />

                    <ImageView
                        android:id="@+id/iv_icon_from"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="14dp"
                        android:layout_marginTop="4dp"
                        android:src="@drawable/ic_marker_from"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@id/ll_from_text" />

                    <LinearLayout
                        android:id="@+id/ll_from_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="@id/guideline_address_block"
                        app:layout_constraintEnd_toEndOf="parent">

                        <TextView
                            android:id="@+id/tv_address_from"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/driver_text_primary"
                            android:textSize="15sp"
                            android:fontFamily="@font/app_font_family"
                            android:textStyle="bold"
                            tools:text="ул. Крещатик, 1" />

                        <TextView
                            android:id="@+id/tv_sector_from"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/driver_text_secondary"
                            android:textSize="13sp"
                            android:fontFamily="@font/app_font_family"
                            android:textStyle="bold"
                            android:layout_marginTop="1dp"
                            tools:text="Печерский район" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_stops_container"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="6dp"
                        app:layout_constraintTop_toBottomOf="@id/ll_from_text"
                        app:layout_constraintBottom_toTopOf="@id/ll_to_text"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <ImageView
                        android:id="@+id/iv_icon_to"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="14dp"
                        android:layout_marginTop="4dp"
                        android:src="@drawable/ic_marker_to"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@id/ll_to_text" />

                    <LinearLayout
                        android:id="@+id/ll_to_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintTop_toBottomOf="@id/ll_stops_container"
                        app:layout_constraintStart_toStartOf="@id/guideline_address_block"
                        app:layout_constraintEnd_toEndOf="parent">

                        <TextView
                            android:id="@+id/tv_address_to"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/driver_text_primary"
                            android:textSize="15sp"
                            android:fontFamily="@font/app_font_family"
                            android:textStyle="bold"
                            tools:text="проспект Победы, 45" />

                        <TextView
                            android:id="@+id/tv_sector_to"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/driver_text_secondary"
                            android:textSize="13sp"
                            android:fontFamily="@font/app_font_family"
                            android:textStyle="bold"
                            android:layout_marginTop="1dp"
                            tools:text="Шулявка" />
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="14dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true">

                        <TextView
                            android:id="@+id/tv_tariff_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/driver_neon_teal"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/app_font_family"
                            tools:text="Стандарт" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@drawable/bg_driver_input"
                            android:backgroundTint="@color/driver_card_bg"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:layout_marginStart="10dp">

                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:src="@drawable/ic_arrow_back_black"
                                android:rotation="135"
                                app:tint="#00E676" />

                            <TextView
                                android:id="@+id/tv_activity_bonus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="+3"
                                android:textColor="#00E676"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/app_font_family" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_scheduled_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/bg_driver_input"
                            android:backgroundTint="#ffe03b"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:textColor="#000000"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/app_font_family"
                            android:visibility="gone"
                            tools:visibility="visible"
                            tools:text="Завтра, 14:30" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_distance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:textColor="@color/driver_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/app_font_family"
                        tools:text="2.4 км" />
                </RelativeLayout>

                <Button
                    android:id="@+id/btn_open_active"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/orders_btn_open"
                    android:backgroundTint="@color/driver_neon_teal"
                    android:textColor="@color/driver_black_bg"
                    android:fontFamily="@font/app_font_family"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textAllCaps="false"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tv_no_active"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/orders_empty_active"
            android:fontFamily="@font/app_font_family"
            android:textColor="@color/driver_text_secondary"
            android:textSize="16sp"
            android:layout_gravity="center" />
    </FrameLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_history"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:paddingTop="12dp"
        android:clipToPadding="false"
        tools:listitem="@layout/item_history_order" />

</FrameLayout>