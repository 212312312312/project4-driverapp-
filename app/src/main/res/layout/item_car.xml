<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="0dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="@color/driver_card_bg"
    android:layout_marginBottom="2dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="14dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="64dp"
            android:layout_height="64dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/driver_black_bg">

            <ImageView
                android:id="@+id/img_car_item"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_car"
                android:scaleType="centerCrop" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:id="@+id/tv_item_model"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Skoda Octavia"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/app_font_family"
                android:textColor="@color/driver_text_primary"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/tv_item_plate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="AA 1234 BB"
                    android:textSize="14sp"
                    android:fontFamily="@font/app_font_family"
                    android:textColor="@color/driver_text_primary"/>

                <View
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@drawable/bg_round_button"
                    android:backgroundTint="@color/driver_text_secondary"/>

                <TextView
                    android:id="@+id/tv_item_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="АКТИВНЕ"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/app_font_family"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_click_to_activate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Натисніть, щоб обрати"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/app_font_family"
                android:textSize="13sp"/>
        </LinearLayout>

        <ImageView
            android:id="@+id/img_check_active"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_check_mark"
            app:tint="@color/driver_neon_teal"
            android:visibility="gone"
            android:layout_marginStart="16dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>