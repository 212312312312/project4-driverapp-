<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/driver_black_bg">

    <RelativeLayout
        android:id="@+id/header_create"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginHorizontal="24dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_arrow_back_black"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            app:tint="@color/driver_text_primary"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"/>

        <TextView
            android:id="@+id/tv_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/filter_create_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/driver_text_primary"
            android:fontFamily="@font/app_font_family"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/btn_back"
            android:layout_marginStart="16dp"/>
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/header_create"
        app:layout_constraintBottom_toTopOf="@id/btn_container_layout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <EditText
                android:id="@+id/et_filter_name"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@drawable/bg_driver_input"
                android:hint="@string/filter_name_hint"
                android:paddingHorizontal="16dp"
                android:textColor="@color/driver_text_primary"
                android:textColorHint="@color/driver_text_secondary"
                android:fontFamily="@font/app_font_family"
                android:inputType="textCapSentences" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/filter_section_from"
                android:textColor="@color/driver_neon_teal"
                android:textSize="13sp"
                android:fontFamily="@font/app_font_family"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rg_from_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_distance"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="@string/filter_type_distance"
                    android:buttonTint="@color/driver_neon_teal"
                    android:fontFamily="@font/app_font_family"
                    android:textColor="@color/driver_text_primary" />

                <RadioButton
                    android:id="@+id/rb_from_sectors"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/filter_type_sectors"
                    android:buttonTint="@color/driver_neon_teal"
                    android:fontFamily="@font/app_font_family"
                    android:textColor="@color/driver_text_primary" />
            </RadioGroup>

            <LinearLayout
                android:id="@+id/container_distance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_distance_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_radius_default"
                    android:fontFamily="@font/app_font_family"
                    android:textColor="@color/driver_text_primary" />

                <SeekBar
                    android:id="@+id/sb_distance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:max="60"
                    android:progress="10"
                    android:thumbTint="@color/driver_neon_teal"
                    android:progressTint="@color/driver_neon_teal"
                    android:progressBackgroundTint="@color/driver_text_secondary" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_select_from_sectors"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:text="@string/filter_btn_select_sectors"
                android:fontFamily="@font/app_font_family"
                android:textColor="@color/driver_text_primary"
                android:visibility="gone"
                app:strokeColor="@color/driver_neon_teal"
                app:cornerRadius="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/filter_section_to"
                android:textColor="@color/driver_neon_teal"
                android:textSize="13sp"
                android:fontFamily="@font/app_font_family"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_select_to_sectors"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:text="@string/filter_btn_select_to_sectors"
                android:fontFamily="@font/app_font_family"
                android:textColor="@color/driver_text_primary"
                app:strokeColor="@color/driver_neon_teal"
                app:cornerRadius="8dp" />

            <TextView
                android:id="@+id/tv_selected_to_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/filter_selected_count_default"
                android:fontFamily="@font/app_font_family"
                android:textColor="@color/driver_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/filter_section_tariff"
                android:textColor="@color/driver_neon_teal"
                android:textSize="13sp"
                android:fontFamily="@font/app_font_family"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rg_tariff_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_simple"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="@string/filter_tariff_simple"
                    android:buttonTint="@color/driver_neon_teal"
                    android:fontFamily="@font/app_font_family"
                    android:textColor="@color/driver_text_primary" />

                <RadioButton
                    android:id="@+id/rb_complex"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/filter_tariff_complex"
                    android:buttonTint="@color/driver_neon_teal"
                    android:fontFamily="@font/app_font_family"
                    android:textColor="@color/driver_text_primary" />
            </RadioGroup>

            <LinearLayout
                android:id="@+id/container_simple_tariff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/et_min_price"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_driver_input"
                    android:hint="@string/filter_hint_min_price"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="12dp"
                    android:fontFamily="@font/app_font_family"
                    android:textColor="@color/driver_text_primary"
                    android:textColorHint="@color/driver_text_secondary" />

                <EditText
                    android:id="@+id/et_min_price_km"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_driver_input"
                    android:hint="@string/filter_hint_min_price_km"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="12dp"
                    android:fontFamily="@font/app_font_family"
                    android:textColor="@color/driver_text_primary"
                    android:textColorHint="@color/driver_text_secondary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/container_complex_tariff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/et_complex_min_price"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_driver_input"
                    android:hint="@string/filter_hint_min_price"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="12dp"
                    android:fontFamily="@font/app_font_family"
                    android:textColor="@color/driver_text_primary"
                    android:textColorHint="@color/driver_text_secondary" />

                <EditText
                    android:id="@+id/et_complex_km_in_min"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_driver_input"
                    android:enabled="true"
                    android:hint="@string/filter_hint_complex_km"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="12dp"
                    android:fontFamily="@font/app_font_family"
                    android:textColor="@color/driver_text_primary"
                    android:textColorHint="@color/driver_text_secondary" />

                <EditText
                    android:id="@+id/et_complex_city"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_driver_input"
                    android:hint="@string/filter_hint_city_price"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="12dp"
                    android:fontFamily="@font/app_font_family"
                    android:textColor="@color/driver_text_primary"
                    android:textColorHint="@color/driver_text_secondary" />

                <EditText
                    android:id="@+id/et_complex_suburbs"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_driver_input"
                    android:enabled="true"
                    android:hint="@string/filter_hint_suburb_price"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="12dp"
                    android:fontFamily="@font/app_font_family"
                    android:textColor="@color/driver_text_primary"
                    android:textColorHint="@color/driver_text_secondary" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/filter_section_payment"
                android:textColor="@color/driver_neon_teal"
                android:textSize="13sp"
                android:fontFamily="@font/app_font_family"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/sp_payment_type"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_driver_input"
                android:popupBackground="@color/driver_black_bg" />

            <View
                android:layout_width="match_parent"
                android:layout_height="24dp" />

        </LinearLayout>
    </ScrollView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/btn_container_layout"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_driver_btn"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_create_filter"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/filter_btn_create"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:fontFamily="@font/app_font_family"
            android:textStyle="bold"
            android:textColor="@color/driver_text_black"
            android:background="@android:color/transparent"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>