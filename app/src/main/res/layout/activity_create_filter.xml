<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/driver_black_bg">

    <RelativeLayout
        android:id="@+id/header_create"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_back_create"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back_black"
            app:tint="@color/driver_text_primary" />

        <TextView
            android:id="@+id/tv_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Створення фільтра"
            android:textColor="@color/driver_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/header_create"
        app:layout_constraintBottom_toTopOf="@id/btn_create_filter">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <EditText
                android:id="@+id/et_filter_name"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@drawable/bg_driver_input"
                android:hint="Назва фільтра (напр. Центр)"
                android:paddingHorizontal="16dp"
                android:textColor="@color/driver_text_primary"
                android:textColorHint="@color/driver_text_secondary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="ЗВІДКИ"
                android:textColor="@color/driver_neon_teal"
                android:textSize="12sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rg_from_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_distance"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="Відстань"
                    android:textColor="@color/driver_text_primary" />

                <RadioButton
                    android:id="@+id/rb_from_sectors"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Сектори"
                    android:textColor="@color/driver_text_primary" />
            </RadioGroup>

            <LinearLayout
                android:id="@+id/container_distance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_distance_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Радіус: 5.0 км"
                    android:textColor="@color/driver_text_primary" />

                <SeekBar
                    android:id="@+id/sb_distance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="60"
                    android:progress="10" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_select_from_sectors"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Вибрати сектори"
                android:visibility="gone"
                app:strokeColor="@color/driver_neon_teal" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="КУДИ"
                android:textColor="@color/driver_neon_teal"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_select_to_sectors"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="+ Сектори призначення"
                app:strokeColor="@color/driver_neon_teal" />

            <TextView
                android:id="@+id/tv_selected_to_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Вибрано секторів: 0"
                android:textColor="@color/driver_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="ТАРИФ"
                android:textColor="@color/driver_neon_teal"
                android:textSize="12sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rg_tariff_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_simple"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="Простий"
                    android:textColor="@color/driver_text_primary" />

                <RadioButton
                    android:id="@+id/rb_complex"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Складний"
                    android:textColor="@color/driver_text_primary" />
            </RadioGroup>

            <LinearLayout
                android:id="@+id/container_simple_tariff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/et_min_price"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_driver_input"
                    android:hint="Мін. сума замовлення (₴)"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/driver_text_primary" />

                <EditText
                    android:id="@+id/et_min_price_km"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_driver_input"
                    android:hint="Мін. ціна за км (₴/км)"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/driver_text_primary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/container_complex_tariff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/et_complex_min_price"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_driver_input"
                    android:hint="Мін. сума замовлення (₴)"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/driver_text_primary" />

                <EditText
                    android:id="@+id/et_complex_km_in_min"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_driver_input"
                    android:enabled="true"
                    android:hint="Км у мінімалці (напр. 2)"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/driver_text_primary" />

                <EditText
                    android:id="@+id/et_complex_city"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_driver_input"
                    android:hint="Мін. ціна/км У місті (₴/км)"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/driver_text_primary" />

                <EditText
                    android:id="@+id/et_complex_suburbs"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_driver_input"
                    android:enabled="true"
                    android:hint="Мін. ціна/км У передмісті (₴/км)"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/driver_text_primary" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="ТИП ОПЛАТИ"
                android:textColor="@color/driver_neon_teal"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/sp_payment_type"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_driver_input"
                android:popupBackground="@color/driver_black_bg" />

            <View
                android:layout_width="match_parent"
                android:layout_height="40dp" />

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_create_filter"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_margin="20dp"
        android:text="СТВОРИТИ ФІЛЬТР"
        android:textColor="@color/driver_black_bg"
        android:textStyle="bold"
        app:backgroundTint="@color/driver_neon_teal"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>