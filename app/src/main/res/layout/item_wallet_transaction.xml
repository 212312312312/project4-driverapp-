<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:background="@drawable/bg_bottom_sheet_driver"
    android:layout_marginBottom="8dp">

    <ImageView
        android:id="@+id/img_tx_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_wallet"
        android:background="@drawable/bg_circle_gray"
        android:padding="8dp"
        android:layout_marginEnd="16dp"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_tx_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Комісія"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"/>

        <TextView
            android:id="@+id/tv_tx_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Замовлення #123"
            android:textSize="14sp"
            android:textColor="#AAAAAA"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/tv_tx_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12.05 14:30"
            android:textSize="12sp"
            android:textColor="#666666"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_tx_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-15.00 ₴"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#FF5252"/>

</LinearLayout>