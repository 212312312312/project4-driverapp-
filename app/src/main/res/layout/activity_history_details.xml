<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/driver_black_bg">

    <RelativeLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_arrow_back_black"
            android:background="@drawable/bg_round_button"
            android:padding="8dp"
            app:tint="@color/driver_text_primary"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Деталі поїздки"
            android:textColor="@color/driver_text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_centerInParent="true"/>
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/info_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/header">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_driver_input"
            android:padding="12dp"
            android:layout_marginEnd="8dp">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Вартість"
                android:textColor="@color/driver_text_secondary"
                android:textSize="12sp"/>
            
            <TextView
                android:id="@+id/tv_price_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 ₴"
                android:textColor="@color/driver_neon_teal"
                android:textSize="20sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_driver_input"
            android:padding="12dp"
            android:layout_marginStart="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Дистанція"
                android:textColor="@color/driver_text_secondary"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/tv_distance_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 км"
                android:textColor="@color/driver_text_primary"
                android:textSize="20sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardBackgroundColor="@color/driver_black_bg"
        app:layout_constraintTop_toBottomOf="@id/info_panel"
        app:layout_constraintBottom_toBottomOf="parent">

        <fragment
            android:id="@+id/map_detail"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#D9000000"
            android:padding="16dp"
            android:layout_gravity="bottom">
            
            <TextView
                android:id="@+id/tv_from_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="A: ..."
                android:textColor="@color/driver_text_primary"
                android:drawablePadding="8dp"
                app:drawableStartCompat="@drawable/bg_circle_white"/>
            
            <View
                android:layout_width="1dp"
                android:layout_height="12dp"
                android:background="@color/driver_text_secondary"
                android:layout_marginStart="6dp"
                android:layout_marginVertical="2dp"/>

            <TextView
                android:id="@+id/tv_to_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="B: ..."
                android:textColor="@color/driver_text_primary"
                android:drawablePadding="8dp"
                app:drawableStartCompat="@drawable/ic_place_small"/>
        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>