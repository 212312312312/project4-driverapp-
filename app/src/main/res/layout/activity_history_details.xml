<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/driver_black_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_arrow_back_black"
                android:background="@drawable/bg_round_button"
                android:padding="8dp"
                app:tint="@color/driver_text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hist_det_title"
                android:textColor="@color/driver_text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_centerInParent="true" />

        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/driver_card_bg"
            android:padding="16dp"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView android:layout_width="12dp" android:layout_height="12dp"
                    android:src="@drawable/bg_circle_white" android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tv_from_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/hist_det_placeholder_dots"
                    android:textColor="@color/driver_text_primary"
                    android:layout_marginStart="12dp"
                    android:textSize="16sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <ImageView android:layout_width="12dp" android:layout_height="12dp"
                    android:src="@drawable/bg_circle_dark" app:tint="@color/driver_neon_teal"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tv_to_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/hist_det_placeholder_dots"
                    android:textColor="@color/driver_text_primary"
                    android:layout_marginStart="12dp"
                    android:textSize="16sp" />

            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#333" android:layout_marginVertical="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_tariff_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hist_det_placeholder_tariff"
                    android:textColor="@color/driver_text_secondary"
                    android:background="@drawable/bg_status_pill"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:textSize="12sp" />

                <View android:layout_width="0dp" android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tv_distance_detail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hist_det_placeholder_dist"
                    android:textColor="@color/driver_text_secondary"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:id="@+id/tv_price_detail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hist_det_placeholder_price"
                    android:textColor="@color/driver_text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="2dp"
            app:cardBackgroundColor="@color/driver_black_bg"
            app:cardCornerRadius="0dp">

            <fragment
                android:id="@+id/map_detail"
                android:name="com.google.android.gms.maps.SupportMapFragment"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true" />

        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hist_det_label_activity"
            android:textColor="@color/driver_text_secondary"
            android:layout_marginStart="16dp"
            android:layout_marginTop="24dp"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/driver_card_bg"
            android:padding="16dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/hist_det_label_success"
                android:textColor="@color/driver_text_primary"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hist_det_score_plus"
                android:textColor="@color/driver_neon_teal"
                android:textStyle="bold"
                android:textSize="16sp" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hist_det_label_car"
            android:textColor="@color/driver_text_secondary"
            android:layout_marginStart="16dp"
            android:layout_marginTop="24dp"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/driver_card_bg"
            android:padding="16dp"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_car_plate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hist_det_placeholder_plate"
                    android:textColor="@color/driver_text_black"
                    android:background="@drawable/bg_license_plate"
                    android:paddingHorizontal="8dp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_car_model"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hist_det_placeholder_model"
                    android:textColor="@color/driver_text_primary"
                    android:layout_marginStart="16dp"
                    android:textSize="16sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/tv_car_class"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hist_det_placeholder_tariff"
                android:textColor="@color/driver_text_secondary"
                android:layout_marginTop="8dp"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>