<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/driver_black_bg">

    <RelativeLayout
        android:id="@+id/layout_header_delete"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/driver_black_bg"
        android:paddingTop="32dp"
        android:paddingBottom="16dp"
        android:paddingHorizontal="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_arrow_back_black"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            app:tint="@color/driver_text_primary"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Видалення акаунту"
            android:textSize="22sp"
            android:fontFamily="@font/app_font_family"
            android:textStyle="bold"
            android:textColor="@color/driver_text_primary"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/btnBack"
            android:layout_marginStart="16dp" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/layout_header_delete"
        app:layout_constraintBottom_toTopOf="@id/bottom_button_block"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/app_font_family"
                android:lineSpacingExtra="6dp"
                android:textColor="@color/driver_text_primary"
                android:textSize="15sp"
                android:text="Перед тим, як ви відправите запит на видалення, ми повинні сповістити вас про те, що:\n\n• Акаунт не видаляється, якщо на балансі недостатньо коштів, спершу його потрібно поповнити;\n\n• Якщо ваш обліковий запис підключено до автопарку, перед видаленням акаунта подайте запит на вихід з автопарку та дочекайтеся його підтвердження;\n\n• Поточний баланс, транзакції та статистику буде анульовано, а доступ до них стане неможливим;\n\n• Усі бонусні програми, в яких ви берете участь, будуть анульовані, а кошти не будуть виплачені;\n\n• Заявка буде розглянута після 30 днів з моменту подачі, акаунт буде заблоковано упродовж цього часу і ви не зможете користуватися додатком.\n\nПісля видалення драйверського акаунту буде видалено і кур'єрський акаунт (якщо такий був зареєстрований)." />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottom_button_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/driver_black_bg"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/btn_container_layout"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginHorizontal="9dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_driver_btn">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnConfirmDelete"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="Видалити акаунт"
                android:textAllCaps="false"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/driver_text_black"
                android:background="@android:color/transparent"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>