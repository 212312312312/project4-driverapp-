<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/top_up_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/driver_card_bg">

    <!-- ВЕРХНЯ ШАПКА "ПОПОВНЕННЯ БАЛАНСУ" У СТИЛІ ГАМАНЦЯ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-16dp"
        app:cardBackgroundColor="@color/driver_black_bg"
        app:cardCornerRadius="22dp"
        app:cardElevation="4dp"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/header_top_up_inner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="32dp"
            android:paddingBottom="16dp"
            android:paddingHorizontal="16dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="42dp"
                android:layout_height="42dp"
                app:cardBackgroundColor="@color/driver_surface_elevated"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/btn_back"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="10dp"
                    android:src="@drawable/ic_arrow_back_black"
                    app:tint="@color/driver_text_primary"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@null" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Поповнення балансу"
                android:textColor="@color/driver_text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="@font/app_font_family" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ОСНОВНИЙ КОНТЕНТ ЕКРАНУ ПОПОВНЕННЯ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:paddingBottom="110dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toTopOf="@+id/keyboard_button_shield">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Поточний баланс водія зверху -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Поточний баланс"
                android:textColor="@color/driver_text_secondary"
                android:textSize="14sp"
                android:fontFamily="@font/app_font_family"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/tv_balance_integer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="262."
                    android:textColor="@color/driver_text_primary"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/app_font_family" />

                <TextView
                    android:id="@+id/tv_balance_fractional"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="27 ₴"
                    android:textColor="@color/driver_text_secondary"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/app_font_family" />
            </LinearLayout>

            <!-- КАРТКА ВВЕДЕННЯ СУМИ ТА ШВИДКИХ ПРЕСЕТІВ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="@color/driver_black_bg"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Сума поповнення"
                        android:textColor="@color/driver_text_secondary"
                        android:textSize="14sp"
                        android:fontFamily="@font/app_font_family" />

                    <!-- Поле вводу суми з рамкою фокусу та знаком ₴ -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/amount_input_card"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_marginTop="10dp"
                        app:cardBackgroundColor="@color/driver_card_bg"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/driver_neon_teal"
                        app:strokeWidth="1.5dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="16dp">

                            <EditText
                                android:id="@+id/et_amount"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@android:color/transparent"
                                android:hint="200"
                                android:textColorHint="@color/driver_text_secondary"
                                android:textColor="@color/driver_text_primary"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:inputType="number"
                                android:gravity="center_vertical"
                                android:fontFamily="@font/app_font_family" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₴"
                                android:textColor="@color/driver_text_secondary"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/app_font_family" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tv_amount_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Поповнити баланс можна від 200 до 1000 ₴"
                        android:textColor="@color/driver_text_secondary"
                        android:textSize="13sp"
                        tools:ignore="HardcodedText"
                        android:fontFamily="@font/app_font_family" />

                    <!-- Швидкі кнопки вибору суми -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal"
                        android:weightSum="4">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/chip_amount_200"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardBackgroundColor="@color/driver_surface_elevated"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="+200 ₴"
                                android:textColor="@color/driver_text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/app_font_family" />
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/chip_amount_300"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="3dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardBackgroundColor="@color/driver_surface_elevated"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="+300 ₴"
                                android:textColor="@color/driver_text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/app_font_family" />
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/chip_amount_500"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="3dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardBackgroundColor="@color/driver_surface_elevated"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="+500 ₴"
                                android:textColor="@color/driver_text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/app_font_family" />
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/chip_amount_1000"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardBackgroundColor="@color/driver_surface_elevated"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="1000 ₴"
                                android:textColor="@color/driver_text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/app_font_family" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- СПОСІБ ОПЛАТИ (ТІЛЬКИ БАНКІВСЬКА КАРТКА, БЕЗ GOOGLE PAY / MONO PAY) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Спосіб оплати"
                android:textColor="@color/driver_text_secondary"
                android:textSize="15sp"
                android:fontFamily="@font/app_font_family"
                android:layout_marginTop="22dp"
                android:layout_marginHorizontal="16dp" />

            <!-- Прихований блок Google Pay для збереження ID сумісності -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_pay_google"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:visibility="gone">
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/check_google"
                    android:layout_width="1dp"
                    android:layout_height="1dp">
                    <ImageView
                        android:id="@+id/img_check_google"
                        android:layout_width="1dp"
                        android:layout_height="1dp"
                        android:contentDescription="@null" />
                </com.google.android.material.card.MaterialCardView>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_pay_card"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="2dp"
                app:strokeColor="@color/driver_neon_teal"
                app:cardBackgroundColor="@color/driver_black_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:cardBackgroundColor="@color/driver_surface_elevated"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp"
                        android:layout_marginEnd="14dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="9dp"
                            android:src="@drawable/ic_payment_card"
                            app:tint="@color/driver_neon_teal"
                            android:contentDescription="@null" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Банківською карткою"
                            android:textColor="@color/driver_text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/app_font_family" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Visa / Mastercard"
                            android:textColor="@color/driver_text_secondary"
                            android:textSize="13sp"
                            android:fontFamily="@font/app_font_family" />
                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/check_card"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="2dp"
                        app:strokeColor="@color/driver_neon_teal"
                        app:cardBackgroundColor="@android:color/transparent">

                        <ImageView
                            android:id="@+id/img_check_card"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="3dp"
                            android:src="@drawable/ic_check_mark"
                            app:tint="@color/driver_neon_teal"
                            android:visibility="visible"
                            android:contentDescription="@null" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- НИЖНЯ ПАНЕЛЬ З КНОПКОЮ "ПОПОВНИТИ" -->
    <LinearLayout
        android:id="@+id/keyboard_button_shield"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_bottom_sheet_driver"
        android:paddingTop="14dp"
        android:paddingBottom="16dp"
        android:paddingHorizontal="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/btn_continue_container"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/bg_driver_btn">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_continue"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="Поповнити"
                android:textAllCaps="false"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/driver_text_black"
                android:background="@android:color/transparent"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:fontFamily="@font/app_font_family"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>