<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/driver_black_bg">

    <RelativeLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="16dp"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_arrow_back_black"
            app:tint="@color/driver_text_primary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/btn_back"
            android:layout_marginStart="16dp"
            android:text="Поповнення рахунку"
            android:textColor="@color/driver_text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="@font/app_font_family"
            android:layout_centerVertical="true" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:paddingBottom="110dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="На вашому балансі залишилось"
                android:textColor="@color/driver_text_secondary"
                android:textSize="14sp"
                android:fontFamily="@font/app_font_family"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tv_balance_integer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="0"
                    android:textColor="@color/driver_neon_teal"
                    android:textSize="44sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/app_font_family" />

                <TextView
                    android:id="@+id/tv_balance_fractional"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text=".00 ₴"
                    android:textColor="@color/driver_neon_teal"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/app_font_family" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Введіть суму"
                android:textColor="@color/driver_text_secondary"
                android:textSize="14sp"
                android:fontFamily="@font/app_font_family"
                android:layout_marginTop="32dp"
                android:layout_marginHorizontal="24dp" />

            <EditText
                android:id="@+id/et_amount"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_driver_input"
                android:hint="200"
                android:textColorHint="@color/driver_text_secondary"
                android:textColor="@color/driver_text_primary"
                android:inputType="number"
                android:gravity="center_vertical"
                android:paddingVertical="0dp"
                android:paddingHorizontal="16dp"
                android:fontFamily="@font/app_font_family" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="6dp"
                android:text="Поповнити баланс можна від 200 до 1000 грн"
                android:textColor="@color/driver_text_primary"
                android:textSize="12sp"
                tools:ignore="HardcodedText"
                android:fontFamily="@font/app_font_family" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Вибір оплати"
                android:textColor="@color/driver_text_secondary"
                android:textSize="14sp"
                android:fontFamily="@font/app_font_family"
                android:layout_marginTop="32dp"
                android:layout_marginHorizontal="24dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_pay_google"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="2dp"
                app:strokeColor="@color/driver_text_secondary"
                app:cardBackgroundColor="@color/driver_card_bg">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Google Pay"
                        android:textColor="@color/driver_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/app_font_family"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/check_google"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        app:cardCornerRadius="6dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="2dp"
                        app:strokeColor="@color/driver_text_secondary"
                        app:cardBackgroundColor="@android:color/transparent"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true">
                        <ImageView
                            android:id="@+id/img_check_google"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_check_mark"
                            app:tint="@color/driver_neon_teal"
                            android:visibility="gone" />
                    </com.google.android.material.card.MaterialCardView>
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_pay_card"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="2dp"
                app:strokeColor="@color/driver_text_secondary"
                app:cardBackgroundColor="@color/driver_card_bg">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Карткою"
                        android:textColor="@color/driver_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/app_font_family"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/check_card"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        app:cardCornerRadius="6dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="2dp"
                        app:strokeColor="@color/driver_text_secondary"
                        app:cardBackgroundColor="@android:color/transparent"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true">
                        <ImageView
                            android:id="@+id/img_check_card"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_check_mark"
                            app:tint="@color/driver_neon_teal"
                            android:visibility="gone" />
                    </com.google.android.material.card.MaterialCardView>
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/keyboard_button_shield"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/driver_black_bg"
        android:paddingTop="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/btn_continue_container"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginHorizontal="9dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_driver_btn">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_continue"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="Продовжити"
                android:textAllCaps="false"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:background="@android:color/transparent"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>