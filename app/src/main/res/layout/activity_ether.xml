<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ether_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B1C1E">

    <!-- ВЕРХНЯ КАРТКА ШАПКИ З КНОПКОЮ НАЗАД, ЛІЧИЛЬНИКАМИ ФІЛЬТРІВ ТА СЕГМЕНТНИМИ ВКЛАДКАМИ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/header_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-18dp"
        app:cardBackgroundColor="@color/driver_card_bg"
        app:cardCornerRadius="22dp"
        app:cardElevation="4dp"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/header_ether_inner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="30dp"
            android:paddingBottom="12dp"
            android:paddingHorizontal="12dp">

            <!-- Верхній рядок: [ <- ] Ефір .......... [ іконки фільтрів ] -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_btn_back"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    app:cardBackgroundColor="@color/driver_black_bg"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:id="@+id/btn_back"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="10dp"
                        android:src="@drawable/ic_arrow_back_black"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        app:tint="@color/driver_text_primary"
                        android:contentDescription="@null" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tv_ether_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:text="Ефір"
                    android:textSize="20sp"
                    android:fontFamily="@font/app_font_family"
                    android:textStyle="bold"
                    android:textColor="@color/driver_text_primary" />

                <!-- Плашка активних фільтрів справа у шапці (клік відкриває FiltersActivity) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_ether_filters"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    app:cardBackgroundColor="@color/driver_black_bg"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:id="@+id/btn_open_filters"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="12dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:id="@+id/ll_header_filter_auto"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginEnd="10dp">

                            <ImageView
                                android:id="@+id/iv_header_filter_auto"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="@null" />

                            <TextView
                                android:id="@+id/tv_header_filter_auto"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="0"
                                android:textColor="@color/driver_text_primary"
                                android:textSize="15sp"
                                android:fontFamily="@font/app_font_family" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/ll_header_filter_cycle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginEnd="10dp">

                            <ImageView
                                android:id="@+id/iv_header_filter_cycle"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="@null" />

                            <TextView
                                android:id="@+id/tv_header_filter_cycle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="0"
                                android:textColor="@color/driver_text_primary"
                                android:textSize="15sp"
                                android:fontFamily="@font/app_font_family" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/ll_header_filter_ether"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:id="@+id/iv_header_filter_ether"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="@null" />

                            <TextView
                                android:id="@+id/tv_header_filter_ether"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="0"
                                android:textColor="@color/driver_text_primary"
                                android:textSize="15sp"
                                android:fontFamily="@font/app_font_family" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Сегментний перемикач вкладок: [ На зараз (1) | На час (2) ] -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_segmented_tabs"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/driver_black_bg"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:padding="2dp">

                    <TextView
                        android:id="@+id/tab_btn_now"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="На зараз (0)"
                        android:textSize="15sp"
                        android:fontFamily="@font/app_font_family"
                        android:textColor="@color/driver_text_primary"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/tab_btn_scheduled"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="На час (0)"
                        android:textSize="15sp"
                        android:fontFamily="@font/app_font_family"
                        android:textColor="@color/driver_text_secondary"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Прихований TabLayout для збереження сумісності зі старим ID ether_tabs -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/ether_tabs"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- VIEWPAGER ЗІ СТОРІНКАМИ "НА ЗАРАЗ" ТА "НА ЧАС" (чіпи дати всередині сторінки "На час") -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/ether_view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/header_container"
        app:layout_constraintBottom_toTopOf="@id/bottom_ether_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- НИЖНЯ ПАНЕЛЬ: [ Увімкнути ланцюг ] + [ ↑↓ нові / 🕒 час ] -->
    <LinearLayout
        android:id="@+id/bottom_ether_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_bottom_sheet_driver"
        android:paddingHorizontal="10dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_toggle_chain"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            app:cardBackgroundColor="@color/driver_black_bg"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:id="@+id/btn_toggle_chain"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:id="@+id/iv_chain_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tv_chain_button_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Увімкнути ланцюг"
                    android:textColor="@color/driver_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/app_font_family" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_sort_button"
            android:layout_width="58dp"
            android:layout_height="54dp"
            app:cardBackgroundColor="@color/driver_neon_teal"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:id="@+id/btn_sort_orders"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iv_sort_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tv_sort_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="нові"
                    android:textColor="#1A1C1E"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/app_font_family" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pb_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:indeterminateTint="@color/driver_neon_teal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>