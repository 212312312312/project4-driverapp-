<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/driver_black_bg">

    <RelativeLayout
        android:id="@+id/layout_header_pending"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/driver_black_bg"
        android:paddingTop="32dp"
        android:paddingBottom="16dp"
        android:paddingHorizontal="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btn_back_pending"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_arrow_back_black"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            app:tint="@color/driver_text_primary"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tv_title_pending"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Кошти в черзі"
            android:textSize="22sp"
            android:fontFamily="@font/app_font_family"
            android:textStyle="bold"
            android:textColor="@color/driver_text_primary"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/btn_back_pending"
            android:layout_marginStart="16dp" />
    </RelativeLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_pending_transactions"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/driver_black_bg"
        app:layout_constraintTop_toBottomOf="@id/layout_header_pending"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_wallet_transaction" />

</androidx.constraintlayout.widget.ConstraintLayout>