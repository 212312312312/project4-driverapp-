<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_driver"
    android:paddingBottom="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Оберіть метод пошуку замовлення"
        android:textColor="@color/driver_text_secondary"
        android:textSize="14sp"
        android:padding="16dp"
        android:gravity="center"/>

    <RelativeLayout
        android:id="@+id/btnModeHome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="?attr/selectableItemBackground">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_toStartOf="@id/radioHome"
            android:layout_marginEnd="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Додому"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"/>
                
                <TextView
                    android:id="@+id/tvHomeCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="(0/2)"
                    android:textSize="14sp"
                    android:textColor="@color/driver_text_secondary"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/tvHomeSectorName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Сектор не обрано"
                    android:textColor="@color/driver_neon_teal"
                    android:textSize="14sp"
                    android:singleLine="true"
                    android:ellipsize="end"/>

                <ImageView
                    android:id="@+id/btnEditHomeSector"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_edit"
                    app:tint="@color/white"
                    android:padding="4dp"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
        </LinearLayout>

        <RadioButton
            android:id="@+id/radioHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:buttonTint="@color/driver_neon_teal"
            android:clickable="false"/>
    </RelativeLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#33FFFFFF" android:layout_marginHorizontal="16dp"/>

    <RelativeLayout
        android:id="@+id/btnModeChain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="?attr/selectableItemBackground">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ланцюг замовлень"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_centerVertical="true"/>

        <RadioButton
            android:id="@+id/radioChain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:buttonTint="@color/driver_neon_teal"
            android:clickable="false"/>
    </RelativeLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#33FFFFFF" android:layout_marginHorizontal="16dp" android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Відстань подачі"
        android:textColor="@color/driver_text_secondary"
        android:textSize="14sp"
        android:paddingHorizontal="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:layout_marginTop="8dp">

        <ImageButton
            android:id="@+id/btnRadiusMinus"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_round_button_gray"
            android:src="@drawable/ic_chevron" 
            android:rotation="180" 
            app:tint="@color/white"/>
            
        <TextView
            android:id="@+id/tvRadiusValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="3.0 км"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <ImageButton
            android:id="@+id/btnRadiusPlus"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_round_button_gray"
            android:src="@drawable/ic_chevron"
            app:tint="@color/white"/>
    </LinearLayout>

    <SeekBar
        android:id="@+id/seekBarRadius"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="16dp"
        android:max="59" 
        android:progress="5"
        android:progressTint="@color/driver_neon_teal"
        android:thumbTint="@color/driver_neon_teal"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveSettings"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="32dp"
        android:text="ЗБЕРЕГТИ"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@color/driver_neon_teal"
        app:cornerRadius="28dp"/>

</LinearLayout>