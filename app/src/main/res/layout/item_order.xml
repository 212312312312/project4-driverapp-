<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:layout_marginHorizontal="4dp"
    app:cardBackgroundColor="@color/driver_card_bg"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:cardMaxElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:id="@+id/ll_price_background"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_driver_input"
                android:backgroundTint="@color/driver_neon_teal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true">

                <ImageView
                    android:id="@+id/iv_payment_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_payment_cash"
                    app:tint="#000000"/>

                <TextView
                    android:id="@+id/tv_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="#000000"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/app_font_family"
                    tools:text="245 ₴"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_price_per_km"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="@font/app_font_family"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                tools:text="32 грн/км"/>
        </RelativeLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp">

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/axis_barrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_begin="56dp" />

            <ImageView
                android:id="@+id/iv_circle_green"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_circle_green"
                android:layout_marginTop="4dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="@id/axis_barrier" />

            <TextView
                android:id="@+id/id_tv_distance_to_client"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/driver_text_secondary"
                android:textSize="11sp"
                android:gravity="center"
                android:fontFamily="@font/app_font_family"
                app:layout_constraintTop_toBottomOf="@id/iv_circle_green"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="@id/axis_barrier"
                tools:text="0.8 км" />

            <View
                android:id="@+id/v_route_line"
                android:layout_width="2dp"
                android:layout_height="0dp"
                android:layout_marginVertical="4dp"
                android:background="#1AFFFFFF"
                app:layout_constraintTop_toBottomOf="@id/id_tv_distance_to_client"
                app:layout_constraintBottom_toTopOf="@+id/iv_circle_red"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="@id/axis_barrier" />

            <ImageView
                android:id="@+id/iv_circle_red"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_circle_red"
                app:layout_constraintTop_toBottomOf="@id/v_route_line"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="@id/axis_barrier" />

            <TextView
                android:id="@+id/tv_distance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/driver_text_secondary"
                android:textSize="11sp"
                android:gravity="center"
                android:fontFamily="@font/app_font_family"
                app:layout_constraintTop_toBottomOf="@id/iv_circle_red"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="@id/axis_barrier"
                tools:text="5.2 км" />

            <TextView
                android:id="@+id/tv_address_from"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/app_font_family"
                android:maxLines="1"
                app:layout_constraintTop_toTopOf="@id/iv_circle_green"
                app:layout_constraintStart_toEndOf="@id/axis_barrier"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="вул. Хрещатик, 1"/>

            <TextView
                android:id="@+id/tv_sector_from"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="@color/driver_text_secondary"
                android:textSize="13sp"
                android:fontFamily="@font/app_font_family"
                android:layout_marginTop="2dp"
                app:layout_constraintTop_toBottomOf="@id/tv_address_from"
                app:layout_constraintStart_toStartOf="@id/tv_address_from"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="Центр"/>

            <LinearLayout
                android:id="@+id/ll_stops_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@id/tv_sector_from"
                app:layout_constraintBottom_toTopOf="@id/tv_address_to"
                app:layout_constraintStart_toStartOf="@id/tv_address_from"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tv_address_to"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/app_font_family"
                android:maxLines="1"
                app:layout_constraintTop_toTopOf="@id/iv_circle_red"
                app:layout_constraintStart_toStartOf="@id/tv_address_from"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="аеропорт Бориспіль"/>

            <TextView
                android:id="@+id/tv_sector_to"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="@color/driver_text_secondary"
                android:textSize="13sp"
                android:fontFamily="@font/app_font_family"
                android:layout_marginTop="2dp"
                app:layout_constraintTop_toBottomOf="@id/tv_address_to"
                app:layout_constraintStart_toStartOf="@id/tv_address_to"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="Аеропорт"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1AFFFFFF"
            android:layout_marginBottom="10dp"/>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_tariff_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/driver_text_secondary"
                android:textSize="14sp"
                android:fontFamily="@font/app_font_family"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                tools:text="Стандарт"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_driver_input"
                android:backgroundTint="#111111"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_arrow_back_black"
                    android:rotation="135"
                    app:tint="#00E676"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="+3"
                    android:textColor="#00E676"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/app_font_family"/>
            </LinearLayout>
        </RelativeLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>