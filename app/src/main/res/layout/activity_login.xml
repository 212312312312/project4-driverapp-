<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/driver_black_bg"
    android:paddingHorizontal="16dp"
    android:paddingTop="24dp"
    android:paddingBottom="24dp">

    <ImageView
        android:id="@+id/btn_back"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_arrow_back_black"
        app:tint="@color/driver_text_primary"
        android:layout_marginTop="16dp"
        android:padding="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_step_phone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/btn_back"
        app:layout_constraintBottom_toBottomOf="parent"
        android:visibility="visible">

        <TextView
            android:id="@+id/tv_title_phone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_title_entry"
            android:textColor="@color/driver_text_primary"
            android:textSize="32sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/app_font_family"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tv_subtitle_phone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_subtitle_phone"
            android:textColor="@color/driver_text_secondary"
            android:textSize="15sp"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/app_font_family"
            app:layout_constraintTop_toBottomOf="@id/tv_title_phone"
            app:layout_constraintStart_toStartOf="parent" />

        <LinearLayout
            android:id="@+id/container_phone_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="40dp"
            app:layout_constraintTop_toBottomOf="@id/tv_subtitle_phone"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_label_phone"
                android:textColor="@color/driver_text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/app_font_family" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@drawable/bg_driver_input"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_phone_prefix"
                    android:textColor="@color/driver_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp"
                    android:fontFamily="@font/app_font_family" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="24dp"
                    android:background="#33FFFFFF"
                    android:layout_marginEnd="12dp" />

                <EditText
                    android:id="@+id/et_phone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:hint="@string/login_hint_phone_pattern"
                    android:textColor="@color/driver_text_primary"
                    android:textColorHint="#666666"
                    android:textSize="18sp"
                    android:inputType="phone"
                    android:maxLines="1"
                    android:fontFamily="@font/app_font_family" />
            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/tv_switch_to_password"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_action_use_password"
            android:textColor="@color/driver_neon_teal"
            android:textSize="15sp"
            android:paddingVertical="12dp"
            android:paddingEnd="12dp"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/app_font_family"
            app:layout_constraintTop_toBottomOf="@id/container_phone_input"
            app:layout_constraintStart_toStartOf="parent" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_get_code"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="@string/login_btn_get_code"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/driver_text_black"
            android:background="@drawable/bg_driver_btn"
            android:backgroundTint="@color/driver_neon_teal"
            android:textAllCaps="false"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:fontFamily="@font/app_font_family"
            android:layout_marginBottom="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_step_sms"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/btn_back"
        app:layout_constraintBottom_toBottomOf="parent"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_title_sms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_title_sms"
            android:textColor="@color/driver_text_primary"
            android:textSize="32sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/app_font_family"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tv_sms_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_subtitle_sms_sent"
            android:textColor="@color/driver_text_secondary"
            android:textSize="15sp"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="4dp"
            android:fontFamily="@font/app_font_family"
            app:layout_constraintTop_toBottomOf="@id/tv_title_sms"
            app:layout_constraintStart_toStartOf="parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <TextView android:id="@+id/tv_code_1" style="@style/OtpDigitStyle" android:textColor="@color/driver_text_primary" android:fontFamily="@font/app_font_family" />
                    <TextView android:id="@+id/tv_code_2" style="@style/OtpDigitStyle" android:textColor="@color/driver_text_primary" android:fontFamily="@font/app_font_family" />
                    <TextView android:id="@+id/tv_code_3" style="@style/OtpDigitStyle" android:textColor="@color/driver_text_primary" android:fontFamily="@font/app_font_family" />
                    <TextView android:id="@+id/tv_code_4" style="@style/OtpDigitStyle" android:textColor="@color/driver_text_primary" android:fontFamily="@font/app_font_family" />
                    <TextView android:id="@+id/tv_code_5" style="@style/OtpDigitStyle" android:textColor="@color/driver_text_primary" android:fontFamily="@font/app_font_family" />
                    <TextView android:id="@+id/tv_code_6" style="@style/OtpDigitStyle" android:textColor="@color/driver_text_primary" android:fontFamily="@font/app_font_family" />
                </LinearLayout>

                <EditText
                    android:id="@+id/et_code_hidden"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:cursorVisible="false"
                    android:inputType="number"
                    android:maxLength="6"
                    android:textColor="@android:color/transparent"
                    android:importantForAutofill="no" />

            </FrameLayout>

            <TextView
                android:id="@+id/tv_resend_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/login_action_resend_code"
                android:textColor="@color/driver_neon_teal"
                android:gravity="center"
                android:padding="8dp"
                android:fontFamily="@font/app_font_family" />

        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_verify_code"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="@string/login_btn_enter"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/driver_text_black"
            android:background="@drawable/bg_driver_btn"
            android:backgroundTint="@color/driver_neon_teal"
            android:textAllCaps="false"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:fontFamily="@font/app_font_family"
            android:layout_marginBottom="32dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:theme="@style/ThemeOverlay.AppCompat.Dark"
        android:indeterminateTint="@color/driver_neon_teal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>