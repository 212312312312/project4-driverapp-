<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#454754">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Верхняя кнопка "Назад" в квадратной плашке -->
        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_driver_input"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back_black"
            app:tint="#FFFFFF"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Верхняя кнопка "Поддержка" (наушники) в квадратной плашке -->
        <ImageView
            android:id="@+id/btn_support"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_driver_input"
            android:padding="12dp"
            android:src="@drawable/ic_headset"
            app:tint="#FFFFFF"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Фирменный логотип (unit drive) -->
        <LinearLayout
            android:id="@+id/layout_brand_logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintTop_toBottomOf="@id/btn_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_unit_loader"
                android:scaleType="fitCenter" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="unit"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold"
                android:fontFamily="@font/app_font_family" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="drive"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:fontFamily="@font/app_font_family" />
        </LinearLayout>

        <!-- ================= ШАГ 1: ВВОД НОМЕРА ТЕЛЕФОНА ================= -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_step_phone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="visible"
            app:layout_constraintTop_toBottomOf="@id/layout_brand_logo"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tv_title_phone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:text="Введіть номер телефону"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:fontFamily="@font/app_font_family"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Строка: Поле ввода телефона + Кнопка с ключом (вход по паролю) -->
            <LinearLayout
                android:id="@+id/container_phone_input"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginTop="18dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintTop_toBottomOf="@id/tv_title_phone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Поле телефона -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_driver_input"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_phone_incoming" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="+380"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:fontFamily="@font/app_font_family" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="12dp"
                        android:rotation="90"
                        android:src="@drawable/ic_chevron"
                        app:tint="#FFFFFF" />

                    <EditText
                        android:id="@+id/et_phone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:hint="00 000 00 00"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#8A8D97"
                        android:textSize="18sp"
                        android:inputType="phone"
                        android:maxLength="12"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:fontFamily="@font/app_font_family" />
                </LinearLayout>

                <!-- Кнопка перехода на вход по паролю (иконка ключа справа) -->
                <ImageButton
                    android:id="@+id/tv_switch_to_password"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_driver_input"
                    android:padding="15dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_key_login"
                    android:contentDescription="@string/login_action_use_password" />
            </LinearLayout>

            <!-- Кнопка "Далі" (серая когда номер не введен, бирюзовая когда введен) -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_get_code"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_driver_btn"
                android:enabled="false"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:text="Далі"
                android:textAllCaps="false"
                android:textColor="#3B3D46"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="@font/app_font_family"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ================= ШАГ 2: ВВОД SMS-КОДА ================= -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_step_sms"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/layout_brand_logo"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tv_title_sms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Введіть код із SMS"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:fontFamily="@font/app_font_family"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tv_sms_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="@string/login_subtitle_sms_sent"
                android:textColor="#A6A9B2"
                android:textSize="14sp"
                android:fontFamily="@font/app_font_family"
                app:layout_constraintTop_toBottomOf="@id/tv_title_sms"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <FrameLayout
                android:id="@+id/frame_otp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/tv_sms_subtitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView android:id="@+id/tv_code_1" style="@style/OtpDigitStyle" android:textColor="#FFFFFF" android:fontFamily="@font/app_font_family" />
                    <TextView android:id="@+id/tv_code_2" style="@style/OtpDigitStyle" android:textColor="#FFFFFF" android:fontFamily="@font/app_font_family" />
                    <TextView android:id="@+id/tv_code_3" style="@style/OtpDigitStyle" android:textColor="#FFFFFF" android:fontFamily="@font/app_font_family" />
                    <TextView android:id="@+id/tv_code_4" style="@style/OtpDigitStyle" android:textColor="#FFFFFF" android:fontFamily="@font/app_font_family" />
                    <TextView android:id="@+id/tv_code_5" style="@style/OtpDigitStyle" android:textColor="#FFFFFF" android:fontFamily="@font/app_font_family" />
                    <TextView android:id="@+id/tv_code_6" style="@style/OtpDigitStyle" android:textColor="#FFFFFF" android:fontFamily="@font/app_font_family" />
                </LinearLayout>

                <EditText
                    android:id="@+id/et_code_hidden"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@null"
                    android:cursorVisible="false"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="6"
                    android:textColor="@android:color/transparent" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_resend_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:padding="10dp"
                android:text="@string/login_action_resend_code"
                android:textColor="@color/driver_neon_teal"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="@font/app_font_family"
                app:layout_constraintTop_toBottomOf="@id/frame_otp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_verify_code"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_driver_btn"
                android:enabled="false"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:text="Далі"
                android:textAllCaps="false"
                android:textColor="#3B3D46"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="@font/app_font_family"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Полноэкранное затемнение с вращающейся SVG-анимацией по центру -->
    <FrameLayout
        android:id="@+id/loading_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#B318191D"
        android:clickable="true"
        android:focusable="true"
        android:elevation="24dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/iv_loader"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_unit_loader" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
