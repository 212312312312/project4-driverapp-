<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">

    <TextView
        android:id="@+id/tv_point_address"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="54dp"
        android:text="Адреса точки..."
        android:textColor="@color/driver_text_primary"
        android:textSize="16sp"
        android:fontFamily="@font/app_font_family"
        android:textStyle="bold"
        android:gravity="center_vertical"
        android:paddingVertical="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <ImageView
        android:id="@+id/iv_point_icon"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginStart="16dp"
        android:src="@drawable/ic_circle_green"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_point_address"
        app:layout_constraintBottom_toBottomOf="@id/tv_point_address" />

    <View
        android:id="@+id/view_line_top"
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:background="#444444"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/iv_point_icon"
        app:layout_constraintStart_toStartOf="@id/iv_point_icon"
        app:layout_constraintEnd_toEndOf="@id/iv_point_icon" />

    <View
        android:id="@+id/view_line_bottom"
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:background="#444444"
        app:layout_constraintTop_toBottomOf="@id/iv_point_icon"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/iv_point_icon"
        app:layout_constraintEnd_toEndOf="@id/iv_point_icon" />

</androidx.constraintlayout.widget.ConstraintLayout>