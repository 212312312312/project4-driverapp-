<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/driver_black_bg">

    <RelativeLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="16dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_arrow_back_black"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            app:tint="@color/driver_text_primary"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/stats_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/driver_text_primary"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/btn_back"
            android:layout_marginStart="16dp"/>
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/period_tabs_container"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_driver_input"
        android:backgroundTint="@color/driver_card_bg"
        android:padding="4dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/header">

        <FrameLayout
            android:id="@+id/tab_day"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:id="@+id/tv_tab_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="День"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textColor="@color/driver_text_primary"/>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/tab_week"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:id="@+id/tv_tab_week"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Тиждень"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textColor="@color/driver_text_secondary"/>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/tab_month"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:id="@+id/tv_tab_month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Місяць"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textColor="@color/driver_text_secondary"/>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/tab_all_time"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:id="@+id/tv_tab_all_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Весь час"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textColor="@color/driver_text_secondary"/>
        </FrameLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/btn_lifetime_stats"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_car"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        app:tint="@color/driver_text_primary"
        app:layout_constraintTop_toTopOf="@id/header"
        app:layout_constraintBottom_toBottomOf="@id/header"
        app:layout_constraintStart_toStartOf="@id/period_tabs_container"
        app:layout_constraintEnd_toEndOf="@id/period_tabs_container"
        app:layout_constraintHorizontal_bias="0.91" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/capsule_period_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="#1AFFFFFF"
        app:layout_constraintTop_toBottomOf="@id/period_tabs_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView
            android:id="@+id/tv_current_period"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:text="Сьогодні"
            android:textColor="@color/driver_text_primary"
            android:textStyle="normal"
            android:textSize="13sp"/>
    </com.google.android.material.card.MaterialCardView>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scrollbars="none"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/capsule_period_container"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:text="Зароблено за період"
                android:textColor="@color/driver_text_primary"
                android:textStyle="bold"
                android:textSize="18sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="2dp"
                android:text="З вирахуванням комісії"
                android:textColor="@color/driver_text_secondary"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/tv_total_income"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="0.00 ₴"
                android:textSize="38sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="24dp"/>

            <LinearLayout
                android:id="@+id/layout_no_data"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginBottom="28dp"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Даних поки немає"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:layout_marginBottom="6dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Виконайте перше замовлення і тут з'явиться ваша статистика"
                    android:textColor="@color/driver_text_secondary"
                    android:textSize="13sp"
                    android:gravity="center"/>
            </LinearLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/chart_container"
                android:layout_width="match_parent"
                android:layout_height="210dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginBottom="28dp">

                <View
                    android:id="@+id/grid_line_1"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:background="@drawable/bg_dotted_line"
                    android:layout_marginTop="8dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/tv_chart_y_max"/>

                <View
                    android:id="@+id/grid_line_3"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:background="@drawable/bg_dotted_line"
                    app:layout_constraintBottom_toTopOf="@id/chart_axis_bottom"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/tv_chart_y_min"/>

                <View
                    android:id="@+id/grid_line_2"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:background="@drawable/bg_dotted_line"
                    app:layout_constraintTop_toBottomOf="@id/grid_line_1"
                    app:layout_constraintBottom_toTopOf="@id/grid_line_3"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/tv_chart_y_mid"/>

                <LinearLayout
                    android:id="@+id/chart_bars_container"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:orientation="horizontal"
                    android:gravity="bottom"
                    android:paddingHorizontal="4dp"
                    app:layout_constraintTop_toTopOf="@id/grid_line_1"
                    app:layout_constraintBottom_toBottomOf="@id/grid_line_3"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/tv_chart_y_max"/>

                <TextView
                    android:id="@+id/tv_chart_y_max"
                    android:layout_width="68dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="0.00 ₴"
                    android:textColor="@color/driver_text_secondary"
                    android:textSize="10sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    app:layout_constraintTop_toTopOf="@id/grid_line_1"
                    app:layout_constraintBottom_toBottomOf="@id/grid_line_1"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <TextView
                    android:id="@+id/tv_chart_y_mid"
                    android:layout_width="68dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="0.00 ₴"
                    android:textColor="@color/driver_text_secondary"
                    android:textSize="10sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    app:layout_constraintTop_toTopOf="@id/grid_line_2"
                    app:layout_constraintBottom_toBottomOf="@id/grid_line_2"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <TextView
                    android:id="@+id/tv_chart_y_min"
                    android:layout_width="68dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="0 ₴"
                    android:textColor="@color/driver_text_secondary"
                    android:textSize="10sp"
                    app:layout_constraintTop_toTopOf="@id/grid_line_3"
                    app:layout_constraintBottom_toBottomOf="@id/grid_line_3"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <View
                    android:id="@+id/chart_axis_bottom"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:background="#26FFFFFF"
                    android:layout_marginBottom="24dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/tv_chart_y_min"/>

                <RelativeLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:layout_constraintTop_toBottomOf="@id/chart_axis_bottom"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/tv_chart_y_min">
                    <TextView
                        android:id="@+id/tv_chart_date_start"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="@color/driver_text_secondary"
                        android:textSize="11sp"
                        android:layout_alignParentStart="true"/>
                    <TextView
                        android:id="@+id/tv_chart_date_end"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="@color/driver_text_secondary"
                        android:textSize="11sp"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>

                <LinearLayout
                    android:id="@+id/chart_tooltip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_driver_input"
                    android:backgroundTint="#FA232426"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:visibility="gone"
                    android:gravity="center"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent">
                    <TextView
                        android:id="@+id/tv_tooltip_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:textSize="12sp"/>
                    <TextView
                        android:id="@+id/tv_tooltip_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/driver_text_secondary"
                        android:textSize="10sp"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_detailed_analytics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/driver_card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Детальна аналітика"
                        android:textColor="@color/white"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp"/>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="5dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/stats_method_card" android:textColor="@color/driver_text_secondary" android:textSize="14sp"/>
                        <View android:layout_width="0dp" android:layout_height="10dp" android:layout_weight="1" android:layout_marginHorizontal="8dp" android:background="@drawable/bg_dotted_line"/>
                        <TextView android:id="@+id/tv_income_card" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.00 ₴" android:textColor="@color/white" android:textStyle="bold" android:textSize="15sp"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="5dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/stats_method_cash" android:textColor="@color/driver_text_secondary" android:textSize="14sp"/>
                        <View android:layout_width="0dp" android:layout_height="10dp" android:layout_weight="1" android:layout_marginHorizontal="8dp" android:background="@drawable/bg_dotted_line"/>
                        <TextView android:id="@+id/tv_income_cash" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.00 ₴" android:textColor="@color/white" android:textStyle="bold" android:textSize="15sp"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="5dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/stats_method_balance" android:textColor="@color/driver_text_secondary" android:textSize="14sp"/>
                        <View android:layout_width="0dp" android:layout_height="10dp" android:layout_weight="1" android:layout_marginHorizontal="8dp" android:background="@drawable/bg_dotted_line"/>
                        <TextView android:id="@+id/tv_income_balance" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.00 ₴" android:textColor="@color/white" android:textStyle="bold" android:textSize="15sp"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="5dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/stats_commission_label" android:textColor="@color/driver_text_secondary" android:textSize="14sp"/>
                        <View android:layout_width="0dp" android:layout_height="10dp" android:layout_weight="1" android:layout_marginHorizontal="8dp" android:background="@drawable/bg_dotted_line"/>
                        <TextView android:id="@+id/tv_expense_commission" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.00 ₴" android:textColor="@color/driver_error" android:textStyle="bold" android:textSize="15sp"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="5dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/stats_label_orders" android:textColor="@color/driver_text_secondary" android:textSize="14sp"/>
                        <View android:layout_width="0dp" android:layout_height="10dp" android:layout_weight="1" android:layout_marginHorizontal="8dp" android:background="@drawable/bg_dotted_line"/>
                        <TextView android:id="@+id/tv_orders_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/white" android:textStyle="bold" android:textSize="15sp"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="5dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/stats_label_mileage" android:textColor="@color/driver_text_secondary" android:textSize="14sp"/>
                        <View android:layout_width="0dp" android:layout_height="10dp" android:layout_weight="1" android:layout_marginHorizontal="8dp" android:background="@drawable/bg_dotted_line"/>
                        <TextView android:id="@+id/tv_total_km" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.0 км" android:textColor="@color/white" android:textStyle="bold" android:textSize="15sp"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="5dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/stats_label_avg_price" android:textColor="@color/driver_text_secondary" android:textSize="14sp"/>
                        <View android:layout_width="0dp" android:layout_height="10dp" android:layout_weight="1" android:layout_marginHorizontal="8dp" android:background="@drawable/bg_dotted_line"/>
                        <TextView android:id="@+id/tv_avg_price" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.00 ₴" android:textColor="@color/white" android:textStyle="bold" android:textSize="15sp"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="5dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/stats_label_time" android:textColor="@color/driver_text_secondary" android:textSize="14sp"/>
                        <View android:layout_width="0dp" android:layout_height="10dp" android:layout_weight="1" android:layout_marginHorizontal="8dp" android:background="@drawable/bg_dotted_line"/>
                        <TextView android:id="@+id/tv_total_hours" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0г 0хв" android:textColor="@color/white" android:textStyle="bold" android:textSize="15sp"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>