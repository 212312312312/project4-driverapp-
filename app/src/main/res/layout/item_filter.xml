<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/driver_black_bg"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp"
    app:rippleColor="?attr/colorControlHighlight">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="12dp">

        <!-- ВЕРХНІЙ РЯДОК: НАЗВА ФІЛЬТРА ЗЛІВА + КАСТОМНИЙ PILL-ТУМБЛЕР СПРАВА -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_filter_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:text="@string/filter_item_name_placeholder"
                android:textColor="@color/driver_text_primary"
                android:textSize="19sp"
                android:textStyle="bold"
                android:fontFamily="@font/app_font_family" />

            <!-- Використовуємо MaterialCheckBox з кастомним Pill-фоном у коді (0 стандартних галочок, 100% тумблер з референсу) -->
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/switch_main_toggle"
                android:layout_width="52dp"
                android:layout_height="30dp"
                android:button="@null"
                android:background="@null"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                app:useMaterialThemeColors="false" />
        </LinearLayout>

        <!-- СЕРЕДНІЙ БЛОК ПАРАМЕТРІВ: ЗВІДКИ / КУДИ / ТАРИФ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:id="@+id/row_filter_from"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Звідки: "
                    android:textColor="@color/driver_text_secondary"
                    android:textSize="16sp"
                    android:fontFamily="@font/app_font_family" />

                <TextView
                    android:id="@+id/tv_filter_from"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/driver_text_primary"
                    android:textSize="16sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/app_font_family"
                    tools:text="радіус 1.5 км" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_filter_to"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Куди: "
                    android:textColor="@color/driver_text_secondary"
                    android:textSize="16sp"
                    android:fontFamily="@font/app_font_family" />

                <TextView
                    android:id="@+id/tv_filter_to"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/driver_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/app_font_family"
                    tools:text="НОВОПЕЧЕРСЬКІ ЛИПКИ +4" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_filter_tariff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Тариф: "
                    android:textColor="@color/driver_text_secondary"
                    android:textSize="16sp"
                    android:fontFamily="@font/app_font_family" />

                <TextView
                    android:id="@+id/tv_filter_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/driver_text_primary"
                    android:textSize="16sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/app_font_family"
                    tools:text="200 ₴ за 3 км; місто 27 ₴/км; за м..." />
            </LinearLayout>
        </LinearLayout>

        <!-- НИЖНІЙ ТРИСЕКЦІЙНИЙ ПЕРЕМИКАЧ РЕЖИМІВ: [ АВТО | ЦИКЛ | ЕФІР ] -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/driver_surface_elevated"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="2dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_mode_auto"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="4dp"
                    android:text="Авто"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    android:fontFamily="@font/app_font_family"
                    app:backgroundTint="@null"
                    app:cornerRadius="10dp"
                    app:icon="@drawable/ic_place_small"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconSize="18dp" />

                <View
                    android:id="@+id/divider_mode_1"
                    android:layout_width="1dp"
                    android:layout_height="20dp"
                    android:background="@color/driver_text_secondary"
                    android:alpha="0.35" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_mode_cycle"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="4dp"
                    android:text="Цикл"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    android:fontFamily="@font/app_font_family"
                    app:backgroundTint="@null"
                    app:cornerRadius="10dp"
                    app:icon="@drawable/ic_cycle"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconSize="18dp" />

                <View
                    android:id="@+id/divider_mode_2"
                    android:layout_width="1dp"
                    android:layout_height="20dp"
                    android:background="@color/driver_text_secondary"
                    android:alpha="0.35" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_mode_ether"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="4dp"
                    android:text="Ефір"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    android:fontFamily="@font/app_font_family"
                    app:backgroundTint="@null"
                    app:cornerRadius="10dp"
                    app:icon="@drawable/ic_menu_ether"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconSize="18dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>