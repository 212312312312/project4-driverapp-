<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/driver_black_bg">

    <RelativeLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="12dp"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_arrow_back_black"
            app:tint="@color/driver_text_primary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:id="@+id/ll_price_background"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_price_container"
                android:backgroundTint="@color/driver_neon_teal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:layout_marginEnd="8dp">

                <ImageView
                    android:id="@+id/iv_payment_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_payment_cash"
                    app:tint="#000000" />

                <TextView
                    android:id="@+id/tv_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/order_det_price_placeholder"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/app_font_family" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_distance_header_background"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_price_container"
                android:backgroundTint="@color/driver_card_bg"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp">

                <TextView
                    android:id="@+id/tv_total_distance_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.0 км"
                    android:textColor="@color/driver_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/app_font_family" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/ll_stats_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="0dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:background="@color/driver_card_bg"
        android:paddingVertical="8dp"
        android:paddingHorizontal="16dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/iv_block_activity_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_menu_graph"
                app:tint="@color/driver_text_primary" />

            <TextView
                android:id="@+id/tv_block_activity_bonus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="+0"
                android:textColor="@color/driver_neon_teal"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="@font/app_font_family" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_block_price_per_km"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-₴/км"
            android:textColor="@color/driver_text_secondary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="@font/app_font_family" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_route_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/ll_stats_block"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/ll_sectors_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="start|center_vertical"
        android:background="@color/driver_black_bg"
        android:paddingVertical="8dp"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintTop_toBottomOf="@id/ll_route_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_start_sector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Не визначено"
            android:textColor="@color/driver_text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="@font/app_font_family" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" ➔ "
            android:textColor="@color/driver_neon_teal"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_end_sector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Не визначено"
            android:textColor="@color/driver_text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="@font/app_font_family" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_client_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="0dp"
        android:layout_marginBottom="4dp"
        android:background="@color/driver_card_bg"
        android:paddingVertical="8dp"
        android:paddingHorizontal="16dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/ll_sectors_block"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/iv_client_avatar"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_driver_avatar_placeholder"
                app:tint="@color/driver_text_secondary" />

            <TextView
                android:id="@+id/tv_client_rides"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Поїздок: 0"
                android:textColor="@color/driver_text_primary"
                android:textSize="14sp"
                android:fontFamily="@font/app_font_family" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/iv_client_star"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_stat_star"
                app:tint="#FFD600" />

            <TextView
                android:id="@+id/tv_client_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="5.0"
                android:textColor="@color/driver_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="@font/app_font_family" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_tariff_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="0dp"
        android:layout_marginBottom="4dp"
        android:background="@color/driver_black_bg"
        android:paddingVertical="8dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/ll_client_block"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_tariff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/order_det_tariff_placeholder"
            android:textColor="@color/driver_text_primary"
            android:textStyle="bold"
            android:textSize="15sp"
            android:fontFamily="@font/app_font_family" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_comment_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="0dp"
        android:layout_marginBottom="4dp"
        android:background="@color/driver_card_bg"
        android:paddingVertical="10dp"
        android:paddingHorizontal="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/ll_tariff_block"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/order_det_label_comment"
            android:textColor="@color/driver_text_secondary"
            android:textSize="12sp"
            android:textAllCaps="true"
            android:layout_marginBottom="6dp"
            android:fontFamily="@font/app_font_family" />

        <LinearLayout
            android:id="@+id/ll_comment_bubble"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_margin="4dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp">

            <TextView
                android:id="@+id/tv_comment_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/order_det_comment_placeholder"
                android:textColor="@color/driver_text_primary"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:fontFamily="@font/app_font_family" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_services_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="0dp"
        android:layout_marginBottom="4dp"
        android:background="@color/driver_card_bg"
        android:paddingVertical="10dp"
        android:paddingHorizontal="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/ll_comment_block"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/order_det_label_services"
            android:textColor="@color/driver_text_secondary"
            android:textSize="12sp"
            android:textAllCaps="true"
            android:layout_marginBottom="6dp"
            android:fontFamily="@font/app_font_family" />

        <LinearLayout
            android:id="@+id/ll_services_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp" />

    </LinearLayout>
    <LinearLayout
        android:id="@+id/llPaymentSplitBlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/driver_card_bg"
        android:paddingVertical="10dp"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="4dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/ll_services_block"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Оплата замовлення"
            android:textColor="@color/driver_text_secondary"
            android:textSize="12sp"
            android:textAllCaps="true"
            android:layout_marginBottom="6dp"
            android:fontFamily="@font/app_font_family" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvClientPayDetail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0 ₴ готівкою"
                android:textColor="@color/driver_text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="@font/app_font_family" />

            <TextView
                android:id="@+id/tvCompanyCompensationDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 ₴ на баланс"
                android:textColor="@color/driver_neon_teal"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="@font/app_font_family" />
        </LinearLayout>
    </LinearLayout>
    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.33"
        app:layout_constraintTop_toBottomOf="@id/ll_services_block"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/details_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="@drawable/bg_bottom_sheet_driver"
        android:backgroundTint="@color/driver_card_bg"
        android:padding="24dp"
        android:elevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/map"
        app:layout_constraintBottom_toTopOf="@id/btn_container_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/btn_container_layout"
        android:layout_width="match_parent"
        android:layout_height="63dp"
        android:layout_marginHorizontal="9dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_driver_btn"
        android:elevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/ll_swipe_content_layer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="20dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginEnd="14dp">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:src="@drawable/ic_chevron"
                    app:tint="@color/driver_text_black" />

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:src="@drawable/ic_chevron"
                    android:layout_marginStart="-16dp"
                    app:tint="@color/driver_text_black" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="start">

                <TextView
                    android:id="@+id/tv_btn_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Прийняти"
                    android:textColor="@color/driver_text_black"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/app_font_family" />

                <TextView
                    android:id="@+id/tv_btn_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Проведіть, щоб прийняти"
                    android:textColor="@color/driver_text_black"
                    android:alpha="0.7"
                    android:textSize="13sp"
                    android:fontFamily="@font/app_font_family" />
            </LinearLayout>
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_accept"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text=""
            android:textAllCaps="false"
            android:background="@android:color/transparent"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>