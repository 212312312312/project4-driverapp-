<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/driver_card_bg">

    <!-- РЯДОК 1: ВЕРХНЯ ШАПКА З КНОПКОЮ НАЗАД, ПЛАШКОЮ ЦІНИ ТА ПЛАШКОЮ ДИСТАНЦІЇ -->
    <RelativeLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/driver_card_bg"
        android:paddingTop="12dp"
        android:paddingBottom="10dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_arrow_back_black"
            app:tint="@color/driver_text_primary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:id="@+id/ll_price_background"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_round_button_gray"
                android:backgroundTint="@color/driver_neon_teal"
                android:paddingHorizontal="12dp"
                android:layout_marginEnd="8dp">

                <ImageView
                    android:id="@+id/iv_payment_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_payment_cash"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tv_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/order_det_price_placeholder"
                    android:textColor="#1A1C1E"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/app_font_family" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_distance_header_background"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_round_button_gray"
                android:backgroundTint="#232428"
                android:paddingHorizontal="12dp">

                <TextView
                    android:id="@+id/tv_total_distance_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2.60 км"
                    android:textColor="@color/driver_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/app_font_family" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>

    <View
        android:id="@+id/divider_header"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#383A42"
        app:layout_constraintTop_toBottomOf="@id/header" />

    <!-- РЯДОК 2: ПАНЕЛЬ СТАТИСТИКИ [ 📍 3.11 км   ⚡ 1.12   📈 +3  .........  69.23 ₴/км ] -->
    <LinearLayout
        android:id="@+id/ll_stats_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/driver_card_bg"
        android:paddingVertical="9dp"
        android:paddingHorizontal="16dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/divider_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Дистанція подачі авто -->
            <ImageView
                android:id="@+id/iv_pickup_pin_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tv_pickup_distance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="3.11 км"
                android:textColor="@color/driver_text_primary"
                android:textSize="15sp"
                android:fontFamily="@font/app_font_family" />

            <!-- Коефіцієнт попиту / множник -->
            <LinearLayout
                android:id="@+id/ll_surge_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/iv_surge_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tv_surge_multiplier"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="1.12"
                    android:textColor="@color/driver_text_primary"
                    android:textSize="15sp"
                    android:fontFamily="@font/app_font_family" />
            </LinearLayout>

            <!-- Бали активності -->
            <ImageView
                android:id="@+id/iv_block_activity_icon"
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:layout_marginStart="14dp"
                android:src="@drawable/ic_menu_stats"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tv_block_activity_bonus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="+3"
                android:textColor="@color/driver_neon_teal"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="@font/app_font_family" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_block_price_per_km"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="69.23 ₴/км"
            android:textColor="@color/driver_text_primary"
            android:textSize="15sp"
            android:fontFamily="@font/app_font_family" />
    </LinearLayout>

    <!-- РЯДОК 3: ТОЧКИ МАРШРУТУ -->
    <LinearLayout
        android:id="@+id/ll_route_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/driver_black_bg"
        app:layout_constraintTop_toBottomOf="@id/ll_stats_block"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/divider_route_sectors"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#383A42"
        app:layout_constraintTop_toBottomOf="@id/ll_route_container" />

    <!-- РЯДОК 4: СЕКТОРИ (Борщагівка Кольцова → Борщагівка Микіл) -->
    <LinearLayout
        android:id="@+id/ll_sectors_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="start|center_vertical"
        android:background="@color/driver_black_bg"
        android:paddingVertical="10dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/divider_route_sectors"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_start_sector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Не визначено"
            android:textColor="#C8CBD4"
            android:textSize="16sp"
            android:fontFamily="@font/app_font_family" />

        <TextView
            android:id="@+id/tv_sectors_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="  →  "
            android:textColor="@color/driver_text_secondary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_end_sector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Не визначено"
            android:textColor="#C8CBD4"
            android:textSize="16sp"
            android:fontFamily="@font/app_font_family" />
    </LinearLayout>

    <!-- РЯДОК 5: КЛІЄНТ [ 👤 Поїздок: <50  ...............  ⭐ 5.0 ] -->
    <LinearLayout
        android:id="@+id/ll_client_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/driver_card_bg"
        android:paddingVertical="9dp"
        android:paddingHorizontal="16dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/ll_sectors_block"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/iv_client_avatar"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_driver_avatar_placeholder"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tv_client_rides"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Поїздок: &lt;50"
                android:textColor="#C8CBD4"
                android:textSize="15sp"
                android:fontFamily="@font/app_font_family" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/iv_client_star"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_stat_star"
                app:tint="#FFD600"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tv_client_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="5.0"
                android:textColor="#C8CBD4"
                android:textSize="15sp"
                android:fontFamily="@font/app_font_family" />
        </LinearLayout>
    </LinearLayout>

    <!-- РЯДОК 6: ТАРИФ [ 🚗 Стандарт ] -->
    <LinearLayout
        android:id="@+id/ll_tariff_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#232428"
        android:paddingVertical="9dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/ll_client_block"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/iv_tariff_car_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_car"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tv_tariff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/order_det_tariff_placeholder"
            android:textColor="@color/driver_text_primary"
            android:textSize="15sp"
            android:fontFamily="@font/app_font_family" />
    </LinearLayout>

    <!-- ОПЦІОНАЛЬНИЙ РЯДОК: КОМЕНТАР ДО ЗАМОВЛЕННЯ -->
    <LinearLayout
        android:id="@+id/ll_comment_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/driver_black_bg"
        android:paddingVertical="8dp"
        android:paddingHorizontal="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/ll_tariff_block"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/order_det_label_comment"
            android:textColor="@color/driver_text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="4dp"
            android:fontFamily="@font/app_font_family" />

        <LinearLayout
            android:id="@+id/ll_comment_bubble"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/tv_comment_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/order_det_comment_placeholder"
                android:textColor="@color/driver_text_primary"
                android:textSize="14sp"
                android:fontFamily="@font/app_font_family" />
        </LinearLayout>
    </LinearLayout>

    <!-- ОПЦІОНАЛЬНИЙ РЯДОК: ДОДАТКОВІ ПОСЛУГИ -->
    <LinearLayout
        android:id="@+id/ll_services_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/driver_black_bg"
        android:paddingVertical="8dp"
        android:paddingHorizontal="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/ll_comment_block"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/order_det_label_services"
            android:textColor="@color/driver_text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="4dp"
            android:fontFamily="@font/app_font_family" />

        <LinearLayout
            android:id="@+id/ll_services_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

    <!-- РЯДОК 7: ОПЛАТА ЗАМОВЛЕННЯ [ 👛 145 ₴ готівкою, 35 ₴ на баланс ] -->
    <LinearLayout
        android:id="@+id/llPaymentSplitBlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/driver_black_bg"
        android:paddingVertical="10dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/ll_services_block"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Оплата замовлення"
            android:textColor="@color/driver_text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="6dp"
            android:fontFamily="@font/app_font_family" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="start|center_vertical">

            <ImageView
                android:id="@+id/iv_payment_split_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tvClientPayDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="145 ₴ готівкою,"
                android:textColor="@color/driver_text_primary"
                android:textSize="16sp"
                android:fontFamily="@font/app_font_family" />

            <TextView
                android:id="@+id/tvCompanyCompensationDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="35 ₴ на баланс"
                android:textColor="@color/driver_neon_teal"
                android:textSize="16sp"
                android:fontFamily="@font/app_font_family"
                android:layout_marginStart="6dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- РЯДОК 8: КАРТА МАРШРУТУ НА ВЕСЬ ДОСТУПНИЙ ПРОСТІР -->
    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/llPaymentSplitBlock"
        app:layout_constraintBottom_toTopOf="@id/bottom_accept_panel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Прихований контейнер для зворотної сумісності -->
    <LinearLayout
        android:id="@+id/details_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- РЯДОК 9: НИЖНЯ ПАНЕЛЬ З ЧАСОМ ПОДАЧІ ТА БІРЮЗОВОЮ СВАЙП-КНОПКОЮ "ПРИЙНЯТИ" -->
    <LinearLayout
        android:id="@+id/bottom_accept_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/driver_black_bg"
        android:paddingTop="10dp"
        android:paddingBottom="14dp"
        android:paddingHorizontal="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/ll_pickup_eta_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="10dp">

            <ImageView
                android:id="@+id/iv_pickup_eta_clock"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tv_pickup_eta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="6 хв на подачу авто"
                android:textColor="@color/driver_text_primary"
                android:textSize="16sp"
                android:fontFamily="@font/app_font_family" />
        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/btn_container_layout"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/bg_round_button_gray"
            android:backgroundTint="@color/driver_neon_teal"
            android:elevation="0dp">

            <LinearLayout
                android:id="@+id/ll_static_text_layer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="76dp"
                android:gravity="start"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <TextView
                    android:id="@+id/tv_btn_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Прийняти"
                    android:textColor="#1A1C1E"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/app_font_family" />

                <TextView
                    android:id="@+id/tv_btn_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Проведіть, щоб прийняти"
                    android:textColor="#1A1C1E"
                    android:alpha="0.75"
                    android:textSize="13sp"
                    android:fontFamily="@font/app_font_family" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_chevrons_layer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="18dp"
                android:gravity="center_vertical"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <ImageView
                    android:id="@+id/iv_accept_chevrons"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:src="@drawable/ic_double_chevron"
                    app:tint="#1A1C1E"
                    android:contentDescription="@null" />
            </LinearLayout>

            <!-- Круговий індикатор зворотного відліку з кільцем, що зменшується навколо цифри -->
            <FrameLayout
                android:id="@+id/ll_accept_counter"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="14dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/iv_accept_timer_ring"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tv_accept_timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="10"
                    android:textColor="#1A1C1E"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/app_font_family" />
            </FrameLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_accept"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text=""
                android:textAllCaps="false"
                android:background="@android:color/transparent"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>