<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_driver"
    android:paddingHorizontal="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="32dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="@color/driver_text_secondary"
        android:alpha="0.3"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/navigator_title"
        android:textSize="20sp"
        android:fontFamily="@font/app_font_family"
        android:textStyle="bold"
        android:textColor="@color/driver_text_primary"
        android:layout_marginBottom="16dp" />

    <androidx.cardview.widget.CardView
        android:id="@+id/btn_nav_google"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:cardMaxElevation="0dp"
        app:cardBackgroundColor="@color/driver_card_bg"
        android:foreground="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_logo_google_maps"
                android:layout_marginEnd="16dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/navigator_google_maps"
                android:textSize="16sp"
                android:fontFamily="@font/app_font_family"
                android:textStyle="bold"
                android:textColor="@color/driver_text_primary" />

            <TextView
                android:id="@+id/tv_status_google"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/navigator_status_install"
                android:textSize="14sp"
                android:fontFamily="@font/app_font_family"
                android:textColor="@color/driver_text_secondary"
                android:layout_marginEnd="8dp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/iv_check_google"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_check_mark"
                app:tint="@color/driver_neon_teal"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/btn_nav_waze"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:cardMaxElevation="0dp"
        app:cardBackgroundColor="@color/driver_card_bg"
        android:foreground="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_logo_waze"
                android:layout_marginEnd="16dp"
                android:tint="@color/driver_text_primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/navigator_waze"
                android:textSize="16sp"
                android:fontFamily="@font/app_font_family"
                android:textStyle="bold"
                android:textColor="@color/driver_text_primary" />

            <TextView
                android:id="@+id/tv_status_waze"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/navigator_status_install"
                android:textSize="14sp"
                android:fontFamily="@font/app_font_family"
                android:textColor="@color/driver_text_secondary"
                android:layout_marginEnd="8dp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/iv_check_waze"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_check_mark"
                app:tint="@color/driver_neon_teal"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>