<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="@color/driver_card_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="16dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="false"
        android:focusable="false">

        <ImageView
            android:id="@+id/iv_card_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_payment_card"
            app:tint="@color/driver_text_primary"
            android:layout_marginEnd="16dp"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_card_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="**** **** **** 4321"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/app_font_family"
                android:textColor="@color/driver_text_primary" />

            <TextView
                android:id="@+id/tv_card_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Основна картка для виплат"
                android:textSize="13sp"
                android:fontFamily="@font/app_font_family"
                android:textColor="@color/driver_text_secondary"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/iv_card_check"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_check_mark"
            app:tint="@color/driver_neon_teal"
            android:visibility="gone"
            tools:visibility="visible"
            android:contentDescription="@null" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>