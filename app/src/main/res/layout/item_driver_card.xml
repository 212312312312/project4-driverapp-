<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingHorizontal="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="4dp">

    <!-- Рамка картки з обведенням для активної картки -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_item_container"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="2dp"
        app:strokeColor="@color/driver_neon_teal"
        app:cardBackgroundColor="@color/driver_black_bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:background="?attr/selectableItemBackground">

            <!-- Кільце вибору (Radio indicator як на скріншоті) -->
            <ImageView
                android:id="@+id/iv_card_check"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="14dp"
                android:src="@drawable/ic_circle_green"
                android:contentDescription="@null" />

            <!-- Іконка платіжної картки -->
            <ImageView
                android:id="@+id/iv_card_icon"
                android:layout_width="28dp"
                android:layout_height="22dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_payment_card"
                app:tint="@color/driver_text_secondary"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_card_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="44****7160"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/app_font_family"
                    android:textColor="@color/driver_text_primary" />

                <TextView
                    android:id="@+id/tv_card_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Утримуйте для видалення"
                    android:textSize="12sp"
                    android:fontFamily="@font/app_font_family"
                    android:textColor="@color/driver_text_secondary"
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Бейдж "Активна" поверх верхньої рамки справа (як на скріншоті) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/badge_active_card"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:layout_marginEnd="18dp"
        android:layout_marginTop="-2dp"
        app:cardBackgroundColor="@color/driver_neon_teal"
        app:cardCornerRadius="8dp"
        app:cardElevation="2dp"
        app:strokeWidth="0dp">

        <TextView
            android:id="@+id/tv_badge_active"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="Активна"
            android:textColor="@color/driver_text_black"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="@font/app_font_family" />
    </com.google.android.material.card.MaterialCardView>

</FrameLayout>