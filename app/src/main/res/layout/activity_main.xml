<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/root_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/driver_black_bg">

        <fragment
            android:id="@+id/map"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_menu_container"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="8dp"
            app:cardBackgroundColor="@color/driver_black_bg"
            app:strokeWidth="0dp"
            app:cardElevation="6dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageButton
                android:id="@+id/btn_menu"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:src="@drawable/ic_menu_hamburger"
                android:padding="12dp"
                app:tint="@color/driver_text_primary" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_status_toggle"
            android:layout_width="164dp"
            android:layout_height="46dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="23dp"
            app:cardBackgroundColor="@color/driver_black_bg"
            app:strokeColor="@color/driver_black_bg"
            app:strokeWidth="1dp"
            app:cardElevation="6dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <FrameLayout
                android:id="@+id/switch_track_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="3dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/switch_thumb_card"
                    android:layout_width="88dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="start"
                    app:cardCornerRadius="20dp"
                    app:cardBackgroundColor="@color/driver_card_bg"
                    app:strokeWidth="0dp"
                    app:cardElevation="2dp">

                    <TextView
                        android:id="@+id/tv_switch_status_text"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="Офлайн"
                        android:textColor="@color/driver_text_primary"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif"
                        android:textStyle="bold" />
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/left_controls_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardBackgroundColor="@color/driver_black_bg"
                app:strokeWidth="0dp"
                app:cardElevation="6dp">
                <ImageButton
                    android:id="@+id/btn_hotspots"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackground"
                    android:src="@drawable/ic_stat_star"
                    android:padding="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:tint="@color/driver_text_primary"
                    android:tooltipText="@string/main_tooltip_hotspots" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:cardCornerRadius="8dp"
                app:cardBackgroundColor="@color/driver_black_bg"
                app:strokeWidth="0dp"
                app:cardElevation="6dp">

                <ImageButton
                    android:id="@+id/btn_sectors"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="10dp"
                    android:src="@drawable/ic_puzzle"
                    android:tooltipText="@string/main_tooltip_sectors"
                    app:tint="@color/driver_text_primary" />
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/right_controls_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardBackgroundColor="@color/driver_black_bg"
                app:strokeWidth="0dp"
                app:cardElevation="6dp">
                <ImageButton
                    android:id="@+id/btn_lock_location"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackground"
                    android:src="@drawable/ic_lock_location"
                    android:padding="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:tint="@color/driver_text_primary"
                    android:tooltipText="@string/main_tooltip_lock" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:cardCornerRadius="8dp"
                app:cardBackgroundColor="@color/driver_black_bg"
                app:strokeWidth="0dp"
                app:cardElevation="6dp">
                <ImageButton
                    android:id="@+id/btn_my_location"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackground"
                    android:src="@drawable/ic_place_small"
                    android:padding="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:tint="@color/driver_text_primary" />
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutSearchStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginHorizontal="8dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            app:layout_constraintBottom_toTopOf="@+id/bottom_nav_container"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSearchContainer"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:cardCornerRadius="8dp"
                app:strokeWidth="0dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/driver_black_bg">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipChildren="true">

                    <View
                        android:id="@+id/search_border_animator"
                        android:layout_width="400dp"
                        android:layout_height="400dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_rotating_gradient"
                        android:visibility="gone" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardSearchMode"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        app:cardCornerRadius="6dp"
                        app:strokeWidth="0dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/driver_black_bg"
                        app:rippleColor="@color/driver_neon_teal">

                        <LinearLayout
                            android:id="@+id/btnToggleSearchMode"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:background="?attr/selectableItemBackground"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="12dp"
                            android:gravity="center_vertical"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:id="@+id/tvSearchModeTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/main_search_chain_title"
                                android:textColor="@color/driver_text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvSearchModeSubtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/main_search_chain_subtitle"
                                android:textColor="@color/driver_text_primary"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="48dp"
                android:layout_height="72dp"
                app:cardCornerRadius="8dp"
                app:cardBackgroundColor="@color/driver_black_bg"
                app:rippleColor="@color/driver_neon_teal"
                app:strokeWidth="0dp"
                app:cardElevation="6dp">
                <ImageView
                    android:id="@+id/btnSearchSettings"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_menu_hamburger"
                    android:padding="12dp"
                    android:background="?attr/selectableItemBackground"
                    app:tint="@color/driver_text_primary"
                    android:clickable="true"
                    android:focusable="true" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bottom_nav_container"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_bottom_nav_floating"
            android:backgroundTint="@color/driver_black_bg"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:elevation="12dp"
            android:layout_marginHorizontal="8dp"
            android:layout_marginBottom="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:id="@+id/btn_nav_ether"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">
                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_menu_ether"
                    app:tint="@color/driver_text_primary" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/main_nav_ether"
                    android:textSize="14sp"
                    android:textColor="@color/driver_text_primary"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_nav_orders"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_menu_history"
                        app:tint="@color/driver_text_primary" />
                    <View
                        android:id="@+id/order_badge_dot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_gravity="top|end"
                        android:background="@drawable/bg_circle_red"
                        android:visibility="gone" />
                </FrameLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/main_nav_orders"
                    android:textSize="14sp"
                    android:textColor="@color/driver_text_primary"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_nav_filters"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">
                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_menu_stats"
                    app:tint="@color/driver_text_primary" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/main_nav_filters"
                    android:textSize="14sp"
                    android:textColor="@color/driver_text_primary"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/sector_selection_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:clickable="false"
            android:focusable="false"
            android:visibility="gone">

            <RelativeLayout
                android:id="@+id/header_selection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/driver_black_bg"
                android:paddingTop="32dp"
                android:paddingBottom="16dp"
                android:paddingHorizontal="24dp"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/btn_back_selection"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_arrow_back_black"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    app:tint="@color/driver_text_primary"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true" />

                <TextView
                    android:id="@+id/tv_title_selection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sector_select_title"
                    android:textSize="22sp"
                    android:fontFamily="@font/app_font_family"
                    android:textStyle="bold"
                    android:textColor="@color/driver_text_primary"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@id/btn_back_selection"
                    android:layout_marginStart="16dp" />

                <ImageView
                    android:id="@+id/btn_save_selection"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_check_mark"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true" />
            </RelativeLayout>

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/selection_tabs"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@color/driver_black_bg"
                app:tabIndicatorColor="@color/driver_neon_teal"
                app:tabSelectedTextColor="@color/driver_neon_teal"
                app:tabTextColor="@color/driver_text_secondary"
                app:tabRippleColor="@android:color/transparent"
                app:tabTextAppearance="@style/CarTabTextStyle"
                app:tabSelectedTextAppearance="@style/CarTabTextStyle"
                app:layout_constraintTop_toBottomOf="@id/header_selection"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <EditText
                android:id="@+id/et_search_query"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_margin="16dp"
                android:background="@drawable/bg_driver_input"
                android:hint="@string/sector_select_search_hint"
                android:paddingHorizontal="16dp"
                android:textColor="@color/driver_text_primary"
                android:textColorHint="@color/driver_text_secondary"
                android:fontFamily="@font/app_font_family"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/selection_tabs"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_sectors_list"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@color/driver_black_bg"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/et_search_query"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/main_screen_ui_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="btn_menu_container,btn_status_toggle,left_controls_container,right_controls_container,layoutSearchStatus,bottom_nav_container" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <include
        android:id="@+id/nav_view_content"
        layout="@layout/layout_drawer_content"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start" />

</androidx.drawerlayout.widget.DrawerLayout>