<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/driver_black_bg">

    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    

    <androidx.cardview.widget.CardView
        android:id="@+id/btn_menu_card"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="50dp"
        app:cardCornerRadius="12dp"
        app:cardBackgroundColor="@color/driver_card_bg"
        app:cardElevation="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_menu"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp"
            android:src="@drawable/ic_menu_hamburger"
            app:tint="@color/driver_text_primary"/>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/card_status_pill"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginTop="54dp"
        app:cardCornerRadius="20dp"
        app:cardBackgroundColor="@color/driver_card_bg"
        app:cardElevation="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:animateLayoutChanges="true">

            <View
                android:id="@+id/view_status_indicator"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/bg_circle_dark"
                android:backgroundTint="@color/driver_error"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/tv_driver_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ОФЛАЙН"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/driver_text_primary"
                android:letterSpacing="0.05"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/btn_my_location"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="25dp"
        app:cardBackgroundColor="@color/driver_card_bg"
        app:cardElevation="6dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_panel"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp"
            android:src="@android:drawable/ic_menu_mylocation"
            app:tint="@color/driver_neon_teal"/>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/bottom_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_bottom_sheet_driver"
        android:padding="24dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_ether"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="ЕФІР"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/driver_text_black"
            app:backgroundTint="@color/driver_neon_teal"
            app:cornerRadius="12dp"
            android:elevation="4dp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>