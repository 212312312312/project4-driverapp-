<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/root_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/driver_black_bg">

        <fragment
            android:id="@+id/map"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_menu_container"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="8dp"
            app:cardBackgroundColor="@color/driver_black_bg"
            app:strokeWidth="0dp"
            app:cardElevation="6dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageButton
                android:id="@+id/btn_menu"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:src="@drawable/ic_menu_hamburger"
                android:padding="12dp"
                app:tint="@color/driver_text_primary" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_status_toggle"
            android:layout_width="164dp"
            android:layout_height="46dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="23dp"
            app:cardBackgroundColor="@color/driver_black_bg"
            app:strokeColor="@color/driver_black_bg"
            app:strokeWidth="1dp"
            app:cardElevation="6dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <FrameLayout
                android:id="@+id/switch_track_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="3dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/switch_thumb_card"
                    android:layout_width="88dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="start"
                    app:cardCornerRadius="20dp"
                    app:cardBackgroundColor="@color/driver_surface_elevated"
                    app:strokeWidth="0dp"
                    app:cardElevation="2dp">

                    <TextView
                        android:id="@+id/tv_switch_status_text"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="Офлайн"
                        android:textColor="@color/driver_text_primary"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif"
                        android:textStyle="bold" />
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/left_controls_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardBackgroundColor="@color/driver_black_bg"
                app:strokeWidth="0dp"
                app:cardElevation="6dp">
                <ImageButton
                    android:id="@+id/btn_hotspots"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackground"
                    android:src="@drawable/ic_star_main"
                    android:padding="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:tint="@color/driver_text_primary"
                    android:tooltipText="@string/main_tooltip_hotspots" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:cardCornerRadius="8dp"
                app:cardBackgroundColor="@color/driver_black_bg"
                app:strokeWidth="0dp"
                app:cardElevation="6dp">

                <ImageButton
                    android:id="@+id/btn_sectors"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="10dp"
                    android:src="@drawable/ic_puzzle"
                    android:tooltipText="@string/main_tooltip_sectors"
                    app:tint="@color/driver_text_primary" />
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/right_controls_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardBackgroundColor="@color/driver_black_bg"
                app:strokeWidth="0dp"
                app:cardElevation="6dp">
                <ImageButton
                    android:id="@+id/btn_lock_location"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackground"
                    android:src="@drawable/ic_lock_location"
                    android:padding="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:tint="@color/driver_text_primary"
                    android:tooltipText="@string/main_tooltip_lock" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:cardCornerRadius="8dp"
                app:cardBackgroundColor="@color/driver_black_bg"
                app:strokeWidth="0dp"
                app:cardElevation="6dp">
                <ImageButton
                    android:id="@+id/btn_my_location"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackground"
                    android:src="@drawable/ic_place_small"
                    android:padding="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:tint="@color/driver_text_primary" />
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- ВИДЖЕТ ФОТОКОНТРОЛЯ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPhotoControl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            app:cardCornerRadius="10dp"
            app:cardBackgroundColor="#e67e22"
            app:cardElevation="6dp"
            app:layout_constraintBottom_toTopOf="@+id/layoutSearchStatus"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvPhotoControlTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Потрібно пройти фотоконтроль"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPhotoControlSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Пройдіть фотоконтроль до 14:00"
                        android:textColor="#F0F0F0"
                        android:textSize="12sp" />
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnPassPhotoControl"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_driver_input"
                    android:text="Пройти"
                    android:textColor="@android:color/white"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ВЕРХНИЙ РЯД НИЖНЕГО БЛОКА: КАРТОЧКА РЕЖИМА ПОИСКА ("Ланцюг замовлень") + КНОПКА ШЕСТЕРЕНКИ -->
        <LinearLayout
            android:id="@+id/layoutSearchStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginHorizontal="8dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            app:layout_constraintBottom_toTopOf="@+id/bottom_nav_container"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSearchContainer"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:cardCornerRadius="10dp"
                app:strokeWidth="0dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/driver_black_bg">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipChildren="true">

                    <View
                        android:id="@+id/search_border_animator"
                        android:layout_width="400dp"
                        android:layout_height="400dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_rotating_gradient"
                        android:visibility="gone" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardSearchMode"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        app:cardCornerRadius="8dp"
                        app:strokeWidth="0dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/driver_black_bg"
                        app:rippleColor="@color/driver_neon_teal">

                        <LinearLayout
                            android:id="@+id/btnToggleSearchMode"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:background="?attr/selectableItemBackground"
                            android:paddingHorizontal="18dp"
                            android:gravity="center_vertical"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:id="@+id/ivSearchModeIcon"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_cycle"
                                app:tint="@color/driver_neon_teal" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="16dp"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvSearchModeTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/main_search_chain_title"
                                    android:textColor="@color/driver_text_primary"
                                    android:textSize="18sp"
                                    android:fontFamily="sans-serif-medium"
                                    android:maxLines="1"
                                    android:ellipsize="end" />

                                <TextView
                                    android:id="@+id/tvSearchModeSubtitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="1dp"
                                    android:text="3.0 км"
                                    android:textColor="@color/driver_text_secondary"
                                    android:textSize="14sp"
                                    android:fontFamily="sans-serif"
                                    android:maxLines="1"
                                    android:ellipsize="end" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="68dp"
                android:layout_height="68dp"
                app:cardCornerRadius="10dp"
                app:cardBackgroundColor="@color/driver_black_bg"
                app:rippleColor="@color/driver_neon_teal"
                app:strokeWidth="0dp"
                app:cardElevation="6dp">
                <ImageView
                    android:id="@+id/btnSearchSettings"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_settings"
                    android:padding="19dp"
                    android:background="?attr/selectableItemBackground"
                    app:tint="@color/driver_text_primary"
                    android:clickable="true"
                    android:focusable="true" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- НИЖНЯЯ ПАНЕЛЬ НАВИГАЦИИ: [ Ефір | Замовлення | Фільтри ] -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/bottom_nav_container"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginHorizontal="8dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="@color/driver_black_bg"
            app:cardElevation="10dp"
            app:strokeWidth="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- 1. ЕФІР (іконка фільтра ефіру + лічильник | іконка списку ефіру + лічильник) -->
                <LinearLayout
                    android:id="@+id/btn_nav_ether"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/iv_ether_filter_icon"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_menu_ether"
                            app:tint="@color/driver_text_primary" />

                        <TextView
                            android:id="@+id/tv_ether_filter_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="0"
                            android:textColor="@color/driver_text_primary"
                            android:textSize="19sp"
                            android:fontFamily="sans-serif"
                            android:includeFontPadding="false" />

                        <ImageView
                            android:id="@+id/iv_ether_list_icon"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginStart="10dp"
                            android:src="@drawable/ic_list_bullet"
                            app:tint="@color/driver_text_primary" />

                        <TextView
                            android:id="@+id/tv_ether_list_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="0"
                            android:textColor="@color/driver_text_primary"
                            android:textSize="19sp"
                            android:fontFamily="sans-serif"
                            android:includeFontPadding="false" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/main_nav_ether"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/driver_text_primary" />
                </LinearLayout>

                <!-- Вертикальный разделитель 1 -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/driver_card_bg" />

                <!-- 2. ЗАМОВЛЕННЯ (іконка годинника з історією + бейдж активного замовлення) -->
                <LinearLayout
                    android:id="@+id/btn_nav_orders"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="26dp">

                        <ImageView
                            android:id="@+id/iv_nav_orders_icon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_menu_history"
                            app:tint="@color/driver_text_primary" />

                        <View
                            android:id="@+id/order_badge_dot"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_gravity="top|end"
                            android:background="@drawable/bg_circle_red"
                            android:visibility="gone" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/main_nav_orders"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/driver_text_primary" />
                </LinearLayout>

                <!-- Вертикальный разделитель 2 -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/driver_card_bg" />

                <!-- 3. ФІЛЬТРИ (іконка Авто-прицілу + лічильник | іконка Циклу + лічильник) -->
                <LinearLayout
                    android:id="@+id/btn_nav_filters"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/iv_filter_auto_icon"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_place_small"
                            app:tint="@color/driver_text_primary" />

                        <TextView
                            android:id="@+id/tv_filter_auto_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="0"
                            android:textColor="@color/driver_text_primary"
                            android:textSize="19sp"
                            android:fontFamily="sans-serif"
                            android:includeFontPadding="false" />

                        <ImageView
                            android:id="@+id/iv_filter_cycle_icon"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginStart="10dp"
                            android:src="@drawable/ic_cycle"
                            app:tint="@color/driver_text_primary" />

                        <TextView
                            android:id="@+id/tv_filter_cycle_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="0"
                            android:textColor="@color/driver_text_primary"
                            android:textSize="19sp"
                            android:fontFamily="sans-serif"
                            android:includeFontPadding="false" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/main_nav_filters"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/driver_text_primary" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/sector_selection_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:clickable="false"
            android:focusable="false"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/header_selection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@color/driver_black_bg"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:paddingHorizontal="24dp"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/btn_back_selection"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_arrow_back_black"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    app:tint="@color/driver_text_primary" />

                <TextView
                    android:id="@+id/tv_title_selection"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/sector_select_title"
                    android:textSize="22sp"
                    android:fontFamily="@font/app_font_family"
                    android:textStyle="bold"
                    android:textColor="@color/driver_text_primary"
                    android:layout_marginStart="16dp" />

                <ImageView
                    android:id="@+id/btn_save_selection"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_check_mark"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/selection_tabs"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@color/driver_black_bg"
                app:tabIndicatorColor="@color/driver_neon_teal"
                app:tabSelectedTextColor="@color/driver_neon_teal"
                app:tabTextColor="@color/driver_text_secondary"
                app:tabRippleColor="@android:color/transparent"
                app:tabTextAppearance="@style/CarTabTextStyle"
                app:tabSelectedTextAppearance="@style/CarTabTextStyle"
                app:layout_constraintTop_toBottomOf="@id/header_selection"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <EditText
                android:id="@+id/et_search_query"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_margin="16dp"
                android:background="@drawable/bg_driver_input"
                android:hint="@string/sector_select_search_hint"
                android:paddingHorizontal="16dp"
                android:textColor="@color/driver_text_primary"
                android:textColorHint="@color/driver_text_secondary"
                android:fontFamily="@font/app_font_family"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/selection_tabs"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_sectors_list"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@color/driver_black_bg"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/et_search_query"
